<?xml version="1.0" encoding="utf-8"?>
<level id="Retrosnakelevel" rversion="0.2.5">
	<info>
		<name>Retro Snake</name>
		<description>Scripted snake level, like 1979. Also check ou Retro Pong!</description>
		<author>Unknow~</author>
		<date>2014-04-17</date>
		<sky>yellow_shadow</sky>
		<border texture="yellow_shadow"/>
	</info>
	<limits left="-12.500000" right="12.500000" top="12.500000" bottom="-12.500000"/>
	<script>
--TIMER
gameLoop = {}

--GAME OBJECTS
snakeHead = {}
food = {}
food2 = {}

--VARIABLES
snakeDirection = 1
snakeSteps = 0.5
snakePosX = {}
snakeposY = {}
cellX = {} 
cellY = {}
foodPosX = {}
foodPosY = {}
foodPosX2 = {}
foodPosY2 = {}
partsConnected = 1
gameSpeed = 15
penTime = 0
berrysLeft = 50

function OnLoad()
	Game.Message("I for help")
	--MOVING CAM. TO PLAYAREA
	Game.CameraZoom(-0.0847)
	Game.CameraMove(9, 15)

	--REGISTER KEYS
	Game.SetKeyHook("W", "moveUp")
	Game.SetKeyHook("S", "moveDown")
	Game.SetKeyHook("A", "moveLeft")
	Game.SetKeyHook("D", "moveRight")
	Game.SetKeyHook("I", "info")
	Game.SetKeyHook("G", "startGame")



	--INIT FIELD MATRIX
	initField()
	snakePosX = 5
	snakePosY = 1
	Game.SetBlockPos("snakeHead", cellX[snakePosX], cellY[snakePosY])
	setFoodPos()
	setFoodPos2()
	return true
end

function info()
	Game.Message("Eat 50 Berrys as fast as you can to win this level!")
	Game.Message("For each change of the direction, the game will add 1 second to your current time!")
	Game.Message("W/A/S/D: Move")
	Game.Message("G: Start")
	Game.Message("Good luck. :)")
end

function startGame()
	Game.StartTimer("gameLoop", gameSpeed, 0)
end

--FUNCTION TO INITIALIZE THE GAME FIELD MATRIX
function initField()
    for i=0, 48, 1 do 	 --X
		cellX[i] = i*snakeSteps
    end
	
	for j=0, 24, 1 do	 --Y
        cellY[j] = (j*-1)*(snakeSteps)
    end
end

--SET RANDOM FOOD POSITION
function setFoodPos()
	foodPosX = math.random(47)+1
	foodPosY = math.random(23)+1

	Game.SetBlockPos("food", cellX[foodPosX], cellY[foodPosY])
	
	if(
	7 == foodPosX and 2 == foodPosY or
	8 == foodPosX and 2 == foodPosY or
	7 == foodPosX and 3 == foodPosY or
	8 == foodPosX and 3 == foodPosY or
	
	7 == foodPosX and 19 == foodPosY or
	8 == foodPosX and 19 == foodPosY or
	7 == foodPosX and 20 == foodPosY or
	8 == foodPosX and 20 == foodPosY or
	
	42 == foodPosX and 2 == foodPosY or
	43 == foodPosX and 2 == foodPosY or
	42 == foodPosX and 3 == foodPosY or
	43 == foodPosX and 3 == foodPosY or
	
	42 == foodPosX and 19 == foodPosY or
	43 == foodPosX and 19 == foodPosY or
	42 == foodPosX and 20 == foodPosY or
	43 == foodPosX and 20 == foodPosY or
	
	23 == foodPosX and 10 == foodPosY or
	24 == foodPosX and 10 == foodPosY or
	23 == foodPosX and 11 == foodPosY or
	24 == foodPosX and 11 == foodPosY or
	
	26 == foodPosX and 10 == foodPosY or
	27 == foodPosX and 10 == foodPosY or
	26 == foodPosX and 11 == foodPosY or
	27 == foodPosX and 11 == foodPosY or
	
	13 == foodPosX and 8 == foodPosY or
	14 == foodPosX and 8 == foodPosY or
	13 == foodPosX and 9 == foodPosY or
	14 == foodPosX and 9 == foodPosY or
	
	13 == foodPosX and 14 == foodPosY or
	14 == foodPosX and 14 == foodPosY or
	13 == foodPosX and 15 == foodPosY or
	14 == foodPosX and 15 == foodPosY or
	
	36 == foodPosX and 8 == foodPosY or
	37 == foodPosX and 8 == foodPosY or
	36 == foodPosX and 9 == foodPosY or
	37 == foodPosX and 9 == foodPosY or
	
	36 == foodPosX and 14 == foodPosY or
	37 == foodPosX and 14 == foodPosY or
	36 == foodPosX and 15 == foodPosY or
	37 == foodPosX and 15 == foodPosY or
	
	
	foodPosX &gt;= 18 and foodPosX &lt;= 24 and
	foodPosY &lt;= 1 and foodPosY &gt;= 0 or
	
	foodPosX &gt;= 26 and foodPosX &lt;= 32 and
	foodPosY &gt;= 21 and foodPosY &lt;= 22) then
		setFoodPos()
	end
end

--SET RANDOM FOOD2 POSITION
function setFoodPos2()
	foodPosX2 = math.random(47)+1
	foodPosY2 = math.random(23)+1

	Game.SetBlockPos("food2", cellX[foodPosX2], cellY[foodPosY2])
	
	if(
	7 == foodPosX2 and 2 == foodPosY2 or
	8 == foodPosX2 and 2 == foodPosY2 or
	7 == foodPosX2 and 3 == foodPosY2 or
	8 == foodPosX2 and 3 == foodPosY2 or
	
	7 == foodPosX2 and 19 == foodPosY2 or
	8 == foodPosX2 and 19 == foodPosY2 or
	7 == foodPosX2 and 20 == foodPosY2 or
	8 == foodPosX2 and 20 == foodPosY2 or
	
	42 == foodPosX2 and 2 == foodPosY2 or
	43 == foodPosX2 and 2 == foodPosY2 or
	42 == foodPosX2 and 3 == foodPosY2 or
	43 == foodPosX2 and 3 == foodPosY2 or
	
	42 == foodPosX2 and 19 == foodPosY2 or
	43 == foodPosX2 and 19 == foodPosY2 or
	42 == foodPosX2 and 20 == foodPosY2 or
	43 == foodPosX2 and 20 == foodPosY2 or
	
	23 == foodPosX2 and 10 == foodPosY2 or
	24 == foodPosX2 and 10 == foodPosY2 or
	23 == foodPosX2 and 11 == foodPosY2 or
	24 == foodPosX2 and 11 == foodPosY2 or
	
	26 == foodPosX2 and 10 == foodPosY2 or
	27 == foodPosX2 and 10 == foodPosY2 or
	26 == foodPosX2 and 11 == foodPosY2 or
	27 == foodPosX2 and 11 == foodPosY2 or
	
	13 == foodPosX2 and 8 == foodPosY2 or
	14 == foodPosX2 and 8 == foodPosY2 or
	13 == foodPosX2 and 9 == foodPosY2 or
	14 == foodPosX2 and 9 == foodPosY2 or
	
	13 == foodPosX2 and 14 == foodPosY2 or
	14 == foodPosX2 and 14 == foodPosY2 or
	13 == foodPosX2 and 15 == foodPosY2 or
	14 == foodPosX2 and 15 == foodPosY2 or
	
	36 == foodPosX2 and 8 == foodPosY2 or
	37 == foodPosX2 and 8 == foodPosY2 or
	36 == foodPosX2 and 9 == foodPosY2 or
	37 == foodPosX2 and 9 == foodPosY2 or
	
	36 == foodPosX2 and 14 == foodPosY2 or
	37 == foodPosX2 and 14 == foodPosY2 or
	36 == foodPosX2 and 15 == foodPosY2 or
	37 == foodPosX2 and 15 == foodPosY2 or
	foodPosX == foodPosX2 and foodPosY == foodPosY2 or
	
	foodPosX2 &gt;= 18 and foodPosX2 &lt;= 24 and
	foodPosY2 &lt;= 1 and foodPosY2 &gt;= 0 or
	
	foodPosX2 &gt;= 26 and foodPosX2 &lt;= 32 and
	foodPosY2 &gt;= 21 and foodPosY2 &lt;= 22) then
		setFoodPos2()
	end
end

--MOVEMENTFUNCTIONS
function moveUp()
	if(snakeDirection ~= 2) then
		snakeDirection = 0
		Game.AddPenaltyTime(1.0)
	end
end

function moveDown()
	if(snakeDirection ~= 0) then
		snakeDirection = 2
		Game.AddPenaltyTime(1.0)
	end
end

function moveLeft()
	if(snakeDirection ~= 1) then
		snakeDirection = 3
		Game.AddPenaltyTime(1.0)
	end
end

function moveRight()
	if(snakeDirection ~= 3) then
		snakeDirection = 1
		Game.AddPenaltyTime(1.0)
	end
end
--END MOVEMENTFUNCTIONS

