--MAINLOOP
function gameLoop.Tick()
	snakeX, snakeY = Game.GetBlockPos("snakeHead")

	--MOVE SNAKE
	if(snakeDirection == 0) then
		Game.SetBlockPos("snakeHead", snakeX, snakeY+snakeSteps)
		snakePosY = snakePosY+1
	end
	if(snakeDirection == 1) then
		Game.SetBlockPos("snakeHead", snakeX+snakeSteps, snakeY)
		snakePosX = snakePosX+1
	end
	if(snakeDirection == 2) then
		Game.SetBlockPos("snakeHead", snakeX, snakeY-snakeSteps)
		snakePosY = snakePosY-1
	end
	if(snakeDirection == 3) then
		Game.SetBlockPos("snakeHead", snakeX-snakeSteps, snakeY)
		snakePosX = snakePosX-1
	end
	
	--COLLISION WITH BORDERS
	if(snakePosX &gt; 48 or snakePosX &lt; 2 or snakePosY &lt; -22 or snakePosY &gt; 4) then
		Game.KillPlayer()
		Game.StopTimer("gameLoop")
	end
	
	
	moveBodyTiles()

	--COLLISION WITH FOOD
	if(snakePosX == foodPosX and (snakePosY*-1)+2 == foodPosY) then
	Game.PlaySound("ring");
		if(partsConnected &lt;= 50) then
			partsConnected = partsConnected+1
			berrysLeft = berrysLeft -1
			Game.ClearMessages()
			Game.Message(berrysLeft.." Berrys left!")
			if(berrysLeft &lt;= 0) then
				Game.WinPlayer()
			end
			if(partsConnected == 5) then
				gameSpeed = 12
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 10) then
				gameSpeed = 11
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 15) then
				gameSpeed = 10
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 20) then
				gameSpeed = 9
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 25) then
				gameSpeed = 8
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 30) then
				gameSpeed = 7
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 35) then
				gameSpeed = 6
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 40) then
				gameSpeed = 5
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 48) then
				gameSpeed = 4
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
		end
		setFoodPos()
	end
	if(snakePosX == foodPosX2 and (snakePosY*-1)+2 == foodPosY2) then
		Game.PlaySound("ring");
		if(partsConnected &lt;= 50) then
			partsConnected = partsConnected+1
			berrysLeft = berrysLeft -1
			Game.ClearMessages()
			Game.Message(berrysLeft.." Berrys left!")
			if(berrysLeft &lt;= 0) then
				Game.WinPlayer()
			end
			if(partsConnected == 5) then
				gameSpeed = 12
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 10) then
				gameSpeed = 11
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 15) then
				gameSpeed = 10
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 20) then
				gameSpeed = 9
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 25) then
				gameSpeed = 8
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 30) then
				gameSpeed = 7
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 35) then
				gameSpeed = 6
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 40) then
				gameSpeed = 5
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
			if(partsConnected == 48) then
				gameSpeed = 4
				Game.SetTimerDelay("gameLoop", gameSpeed)
				Game.Message("Speed up!")
			end
		end
		setFoodPos2()
	end
