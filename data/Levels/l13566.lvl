<level id="Basic_Moon" rversion="0.5.2">
	<info>
		<name>Basic - Moon</name>
		<description>Krw's night sky</description>
		<author>tumo</author>
		<date>2014-05-29</date>
		<sky offset="0.001">KRWNightSky</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="0.01" y="0.01" frontlayer="false"/>
		<layeroffset x="0.01" y="0.01" frontlayer="false"/>
		<layeroffset x="0.01" y="0.01" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-26.309055" right="26.309055" top="18.602362" bottom="-18.602362"/>
	<script>

i = 0
gift1 = {}
fakestart = {}
gababa = {}

function OnLoad()
	Game.GetKeyByAction("A", "jump")
return true
end


function gift1.Touch()
	x,y = Game.GetEntityPos("fakestart")
	Game.SetPlayerPosition(x,y,0)
	Game.KillEntity("fakestart")
	i = 1
	Game.Message("Can you finish this?")
end

function Tick()
	if i == 1 then
		time = Game.GetTime()
		Game.SetGravity(0,-10*time)
		
	end
return true
end

function jump()
	i = 0
	Game.Message("yes")
end
	</script>
