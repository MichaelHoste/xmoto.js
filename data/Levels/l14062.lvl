	<info>
		<name>Simon Says - [Peace]</name>
		<description>Do as Simon says! There are also a couple of secrets!</description>
		<author>Peace</author>
		<date>2021-10-07</date>
		<sky>sky1</sky>
        <border texture="invisible"/>
<music name="SpeedItUp" />
	</info>
<script>
secrets=0
failedyet=0
con=0
item=0
on=0
off=Game.GetTime()
