started=0
eggsf=0
function OnLoad()
    Game.SetKeyHook("S", "start")
    Game.SetKeyHook("P", "kon")
Game.SetKeyHook("E", "kon2")
Game.SetKeyHook("A", "kon3")
Game.SetKeyHook("C", "kon4")
Game.SetKeyHook("E", "kon5")

    Game.StartTimer("timer1",100,1)
    return true
end

Game.Message("Press S to skip intro.")
function timer1.Tick()
    if (started==0)
    then
        Game.Message("Welcome to Simon Says!!!")
        Game.Message("Try to find all the secrets!")
        Game.StartTimer("timer2",200,1)
    end 
end
function timer2.Tick()
if (started==0)
    then
    Game.Message("Here is how to play:")
    Game.StartTimer("timer3",200,1)
end
end
function timer3.Tick()
if (started==0)
    then
    Game.Message("If Simon says to do something, then you do it.")
    Game.StartTimer("timer4",200,1)
end
end
function timer4.Tick()
if (started==0)
    then
    Game.Message("If someone else or nobody tells you to do something, then don't do it!")
    Game.StartTimer("timer5",200,1)
end
end
function timer5.Tick()
if (started==0)
    then
    Game.Message("Should be simple..... *he he he he he*")
    Game.StartTimer("timer6",200,1)
end
end
function timer6.Tick()
if (started==0)
    then
    Game.Message("Lets get started... *he he he*")
    Game.StartTimer("timer7",200,1)
end
end
function timer7.Tick()
if (started==0)
    then

    start()

    started=2

end
end

function OnWheel1Touchs(bStatus)

if thiggy==1
then
if (w1+w2)==2
then
thiggy=2
item=5


end
if bStatus1==1
then
w1=1
end
end



if (item)==1
then
    if (bStatus)==1
    then
        

on=Game.GetTime()

if (on-off)>=10
then

Game.Message("Yay! You did it!")
Game.Message("Simon says: Clear the walls.")
item=2

    end
off=2364.3
else 
if (started==2)
then
    on=Game.GetTime()
    off=Game.GetTime()
end   
if (off==2364.3)
then
off=Game.GetTime()

end
    end
    end
end
function start()
    if (started==0)
    then
        Game.Message("Simon says: Balance on your left wheel for 10 seconds.")
        item=1
off=Game.GetTime()
        started=2
    off=Game.GetTime()
    end

    
end
function Zone0.OnEnter()
    if item==2
then
  Game.Message("Yay! You did it!")
Game.Message("Balance on your right wheel for 10 seconds.")
Game.StartTimer("timer9",2000,1)


item=3

end
end
function timer9.Tick()
if item==3
then
Game.Message("Correct! Simon never said to do that!")
Game.Message("Simon Says: Do a clockwise flip.")
item=4
thiggy=0
end
end
function OnWheel2Touchs(bStatus)

if thiggy==1
then
if (w1+w2)==2
then
thiggy=2
item=5


end
if bStatus==1
then
w2=1
end
end


if item==3

then

    if (bStatus)==1
    then
       

on=Game.GetTime()


if (on-off)>10
then
if off > 0
then
if failedyet ==0
then
on=0
off=0
failedyet=1
failed()
con=1
end 
end
end
off=2364.3
else 
    
       

off=Game.GetTime()

end
end
end
function timer8.Tick()
Game.Message("Simon: Maybe there was something.....")
    Game.KillPlayer()
    
end
function failed()
Game.Message("Simon: I never said to do that!")
Game.Message("Simon: Your punishment is DEATH!")
Game.Message("Simon: YOU WILL DIE IN 3 SECONDS!!! THERE IS NOTHING YOU CAN DO TO STOP IT!!!")
Game.StartTimer("timer8",300,1)
end
function kon()
    if con==1
then 
parts=1
end
end

function kon2()
    if parts==1
then 
parts=2
end
end

function kon3()
    if parts==2
then 
parts=3
end
end
function kon4()
    if parts==3
then 
parts=4
end
end

function kon5()
    if parts==4
then 
parts=5
Game.StopTimer("timer8")
Game.Message("Whew! Saved! You found a secret!")
Game.Message("Level Creater: Hey, just for that, I'll give you a time bonus at the end.")

secrets =secrets+1
Game.Message("Simon Says: Do a clockwise flip.")
item=4

end
end
w2=0
w1=0
thiggy=0
sums=0
function OnSomersault(bClockWise)
if item==4
then 
if bClockWise ==1
then
sums = sums+1
if sums==3
then
Game.Message("Well... Hmm... Three is the magic number... So you get a time bonus!")
Game.Message("You found a secret!")
secrets=secrets+1
end
Game.Message("Yay! You did it!")
Game.StartTimer("timer10",500,1)
thiggy=1
else
Game.Message("Yay!... Wait... Wrong one! DIE!!!")
failed2()
end 
end
end

function failed2()
Game.KillPlayer()
end



function timer10.Tick()
Game.Message("Simon says: ")
Game.StartTimer("timer11",200,1)
end
function timer11.Tick()
Game.Message("I guess I should let you go...")
Game.StartTimer("timer12",200,1)
end

function timer12.Tick()
time2=40-(secrets*20)
Game.Message("For finding "..secrets.." secrets you get "..time2.." in added time.")
Game.StartTimer("timer13",200,1)

end

function timer13.Tick()
Game.AddPenaltyTime(time2)
Game.StartTimer("timer14",200,1)
end

function timer14.Tick()
Game.WinPlayer()
end
