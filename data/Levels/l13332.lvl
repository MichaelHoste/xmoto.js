<?xml version="1.0" encoding="utf-8"?>
<level id="sereuncontrollable" rversion="0.5.2">
	<info>
		<name>SeRe - Uncontrollable</name>
		<description>Drive and lean at the same Time, not in my Lvl... ;P   (can be modified...)</description>
		<author>SeRe</author>
		<date>2013-11-28</date>
		<sky driftColor_b="255" driftColor_a="255" driftColor_g="38" driftColor_r="0" drifted="true">Blue1InRainbows</sky>
		<border texture="invisible"/>
		<music name="blockolando" />
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-33.500750" right="18.600750" top="28.306775" bottom="-16.306775"/>
	<script>
zonechcheck = 0
tcheck = 0
tcheck2 = 0
tcheck3 = 0
dcheck1 = 0
nillch = 0
zcheck = 0
dcheck2 = 0
pcheck = 0
ccheck = 0
ccheck3 = 0
pfeilcheck = 0
pfeilcheck2 = 0
rcheck = 0
rcheck1 = 0
rcheck2 = 0
rcheck3 = 0
rcheck4 = 0
rcheck5 = 0
strcheck = 0
Strawberry0 = {}
flower = {}
tux = {}
pfeil = {}
pfeil2 = {}
ring = {}
ring1 = {}
ring2 = {}
ring3 = {}
ring4 = {}
ring5 = {}
ring6 = {}
zone0 = {}
timer2 = {}
light = {}
wr1 = {}
wr2 = {}
wr3 = {}




function OnLoad()
		Game.SetKeyHook(Game.GetKeyByActionTech("PushForward"), "Kill2")
		Game.SetKeyHook(Game.GetKeyByActionTech("PullBack"), "Kill2")
		Game.Message("Welcome to my Level!")
		Game.Message("Don't lean forward or backward unless you want to die...")
	return true
end

function Strawberry0.Touch()
	strcheck = 1
	dcheck1 = 1
	dcheck2 = 1
		Game.SetKeyHook(Game.GetKeyByActionTech("Drive"), "Kill")
		Game.SetKeyHook(Game.GetKeyByActionTech("Brake"), "Kill")
		Game.Message("Great, now go back down the hill without braking or driving!")
	return true
end





function Kill2()
	if dcheck1 == 0 then
		Game.KillPlayer()
end
end




function Kill()
	if dcheck2 == 1 then
		Game.KillPlayer()
end
end









function zone0.OnEnter()
		Game.SetPlayerPosition(500, 0, 0)
end




function tux.Touch()
	if zcheck == 0 then
		Game.Message("You're here for a Present, aren't you?")
	zcheck = 1
end
end



function pfeil.Touch()
	if pfeilcheck == 0 then
		Game.Message("If yes, press C!")
		Game.SetKeyHook("C", "Check")
		Game.KillEntity("tux")
	pfeilcheck = 1
end
end


function Check()
	if ccheck == 0 then
		Game.Message("Wait, I'm checking if there is a Present for you!")
		Game.StartTimer("timer2",700,1)
	ccheck = 1
else
	if tcheck2 == 0 then
		Game.Message("I'm still checking...")
else
	if tcheck2 == 1 and ccheck3 == 0 then	
		Game.Message("Yeah, there is one!")
		Game.Message("Go right, there it should be...")
		Game.KillEntity("wr1")
		Game.KillEntity("wr2")
		Game.KillEntity("wr3")
	ccheck3 = 1
end
end
end
end


function timer2.Tick()
	tcheck2 = 1
end






function light.Touch()
		Game.SetPlayerPosition(250, 0, 0)
		Game.Message("Here it is -")
		Game.Message("welcome to my Secret...")
end





function ring.Touch()
	if rcheck == 0 then
		Game.Message("That's a colorful Secret, isn't it?!")
	rcheck = 1
end
end






function ring1.Touch()
	if rcheck1 == 0 then
		Game.Message("I hope you like my lvl and the Secret!")
	rcheck1 = 1
end
end


function ring2.Touch()
	if rcheck2 == 0 and dcheck1 == 0 then
		Game.Message("You can activate lean forward and backward by pressing L...")
		Game.SetKeyHook("L", "lean")
	rcheck2 = 1
else
	if rcheck2 == 0 and dcheck2 == 1 then
		Game.Message("You can activate braking and driving by pressing D...")
		Game.SetKeyHook("D", "Drive")
	rcheck2 = 1		
end
end
end


function lean()
	dcheck1 = 1
end

function Drive()
	dcheck2 = 0
end

function ring3.Touch()
	if rcheck3 == 0 then
		Game.Message("MERRY CHRISTMAS to all Players!")
	rcheck3 = 1
end
end

function ring4.Touch()
	if rcheck4 == 0 then
		Game.Message("And a happy new Year...")
	rcheck4 = 1
end
end

function ring5.Touch()
	if rcheck5 == 0 then
		Game.Message("See you...")
	rcheck5 = 1
end
end





function pfeil2.Touch()
	if strcheck == 1 and pfeilcheck2 == 0 then
		Game.Message("Well done!")
	pfeilcheck2 = 1
	return 1
end
end







	</script>
