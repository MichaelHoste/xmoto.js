function up()---to move the bird up---

	if y7&lt;14.5 then---tells xm how high it could get---
		x0, y0 = Game.GetBlockPos("bird0")
  	Game.SetBlockPos("bird0", x0, y0 + 1.2)
 		x1, y1 = Game.GetBlockPos("bird1")
  	Game.SetBlockPos("bird1", x1, y1 + 1.2)
 		x2, y2 = Game.GetBlockPos("eyeb")
  	Game.SetBlockPos("eyeb", x2, y2 + 1.2)
 		x3, y3 = Game.GetBlockPos("eyew")
  	Game.SetBlockPos("eyew", x3, y3 + 1.2)
 		x4, y4 = Game.GetBlockPos("white")
  	Game.SetBlockPos("white", x4, y4 + 1.2)
 		x5, y5 = Game.GetBlockPos("orange0")
  	Game.SetBlockPos("orange0", x5, y5 + 1.2)
 		x6, y6 = Game.GetBlockPos("orange1")
  	Game.SetBlockPos("orange1", x6, y6 + 1.2)
end
end


function Tick()
		x7, y7 = Game.GetBlockPos("bird0")
		x8, y8 = Game.GetBlockPos("bird1")

return true
		end
		
function ticktimer.Tick()


	if y8&lt;6.61 then
		Game.SetDynamicBlockNone("bird0")
		Game.SetDynamicBlockNone("bird1")
		Game.SetDynamicBlockNone("white")
		Game.SetDynamicBlockNone("orange0")
		Game.SetDynamicBlockNone("orange1")
		Game.SetDynamicBlockNone("eyew")
		Game.SetDynamicBlockNone("eyeb")
	stopped = 1
end
	if stopped==1 and y8&gt;6.61 then
		DOWNN()
		stopped=0

		return true
end
end

function checkpoint.OnUse()
	if wincheck==0 then
		Game.Message(roundspassed[math.random(1,7)])
		Game.Message("You managed "..round.." rounds! ;)")
		Game.AddPenaltyTime(900 - round*10)
		Game.StartTimer("wintimer",20 ,1)
	wincheck=1
	kcheck=0
end
end


function win()
	if wincheck==0 then
		Game.Message(roundspassed[math.random(1,7)])
		Game.Message("You managed "..round.." rounds! ;)")
		Game.AddPenaltyTime(800 - round*10)
		Game.StartTimer("wintimer",20 ,1)
	wincheck=1
	kcheck=0
end
end


function wintimer.Tick()
	Game.WinPlayer()
end


function DOWNN()
Game.SetDynamicBlockTranslation("white", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("bird0", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("bird1", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("eyew", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("eyeb", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("orange0", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("orange1", 0, -950000, 160000000, 0, 0)
Game.SetDynamicBlockTranslation("white", 0, 0.4, 60, 0, 0)---for the flap of the bird---
end



function whatever()
	if snumber&lt;50 then
		snumber=snumber+1
end
	if snumber==50 then
		sx,sy = Game.GetEntityPos("lighten")
		Game.SetPlayerPosition(sx,sy,0)
		snumber=snumber+1
		kcheck = 0
		wincheck=1
		Game.Message("Welcome to the boring secret...")
		Game.Message("To see the player press F4(resets the camera script)!")
		Game.Message("Seems like a crazy Birdfunpark for biker...")
		Game.SetDynamicBlockNone("block00")
