function timer0.Tick()---nothing special, the blocks find their way...---
Game.SetBlockCenter("block00", -13.74377, -1.05539)
	Game.SetDynamicBlockSelfRotation("block00", t, 0, t2/4)
Game.SetBlockCenter("block01", -13.74, -12.82)
	Game.SetDynamicBlockSelfRotation("block01", t, 0, t2/4)
