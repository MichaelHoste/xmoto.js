function OnLoad()

	Game.CameraZoom(-0.14)---you can edit the camera zoom here---

		Game.CameraMove(0, -70) ---where the camera should be(read in the wiki how it works ;)---

				Game.Message("Welcome to my level! :D")
					
					Game.Message("The bird goes up with W. You can finish by using the checkpoint...")

							Game.SetKeyHook(Game.GetKeyByActionTech(xD[math.random(1,4)]), "whatever")

								Game.StartTimer("timer0",200 ,1)---the first timer ticks after the introduction was showed...---

						Game.SetDynamicBlockTranslation("white", 0, 0.4, 60, 0, 0)---for the flap of the bird---

				Game.SetKeyHook("W", "up")

Game.StartTimer("ticktimer",1 ,0)

Game.MoveBlock("vblock00", -3000, -0)---move away all the blocks with other colours---
