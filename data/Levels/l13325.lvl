<level id="Levels_Of_A_Legend_the_smartest_trick" rversion="0.5.2">
	<info>
		<name>Levels Of A Legend - the smartest trick</name>
		<description></description>
		<author>tumo, David, *Awesome~Style*</author>
		<date>2013-11-27</date>
		<sky driftColor_b="74" BlendTexture="Sky3" driftColor_g="225" driftZoom="9.3" color_g="83" driftColor_a="255" color_a="255" color_b="23" driftColor_r="255" offset="0.017" drifted="true" color_r="255" zoom="9.2">Sky3</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.01" y="0.0" frontlayer="false"/>
		<layeroffset x="0.02" y="0.01" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-7.500000" right="7.500000" top="7.500000" bottom="-7.500000"/>
	<script>
flower = {}
--For tha secret---
secret = {}
Ring1 = {}
Ring2 = {}
Ring3 = {}
Ring4 = {}
Ring5 = {}
fakeflower = {}
i = 0
---Real script---


function flower.Touch()
	Game.WinPlayer()
end

---Was hard, wasn't it?---
---Here's code for a useless secret---

function secret.Touch()
	Game.SetPlayerPosition(100,88,1)
	Game.SetKeyHook(Game.GetKeyByActionTech("Drive"), "Driving")
	Game.Message("Accelerate only in 'one press' -bursts or you'll die!!")
	Game.Message("Can you get all 5 Rings?")
	Game.Message("If so, touch the check to finish!")
end

function Driving()
	Game.AddForceToPlayer(0, -100000, 0, 5, 0)
end

function Ring1.Touch()
	i = i + 1
	Game.KillEntity("Ring1")
	Game.Message((i).." / 5")
end

function Ring2.Touch()
	i = i + 1
	Game.KillEntity("Ring2")
	Game.Message((i).." / 5")
end

function Ring3.Touch()
	i = i + 1
	Game.KillEntity("Ring3")
	Game.Message((i).." / 5")
end

function Ring4.Touch()
	i = i + 1
	Game.KillEntity("Ring4")
	Game.Message((i).." / 5")
end

function Ring5.Touch()
	i = i + 1
	Game.KillEntity("Ring5")
	Game.Message((i).." / 5")
end

function fakeflower.Touch()
	if i == 5 then
		Game.WinPlayer()
	end
end
	</script>
