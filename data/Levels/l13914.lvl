function button.OnEnter()	
	if a==0 then
		h=1
		speed=3000
		wait=0
		Game.SetDynamicBlockTranslation("bt",h, 0, speed, wait, wait+(speed/2))
		h=9.19
		speed=1000
		wait=50
		Game.SetDynamicBlockTranslation("B1", 0,h, speed, wait, wait+(speed/2))
	a=1
end
end
