<level id="crrepulsion" rversion="0.5.2">
	<info>
		<name>CR - Repulsion</name>
		<description></description>
		<author>CR</author>
		<date>2024-02-20</date>
		<sky color_g="0" color_b="180" zoom="6.7" color_a="255" color_r="255">sky1</sky>
		<border texture="Black"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="TheX"/>
		<sprite_replacement old_name="Flower" new_name="crossthingy"/>
		<sprite_replacement old_name="Wrecker" new_name="deathstar"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-7.500000" right="7.500000" top="5.000000" bottom="-5.000000"/>
	<script>
function Tick()
  xr,yr = Game.GetEntityPos("repeller1")
  xp,yp,b = Game.GetPlayerPosition()
  d = (xp-xr)^2+(yp-yr)^2
  if(d &lt; 10)
  then
    fx = 10000 * (xp - xr)/d^1
    fy = 10000 * (yp - yr)/d^1
    Game.AddForceToPlayer(fx,fy,0,1,0)
  end
  return true
end
	</script>
