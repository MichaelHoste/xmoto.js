<?xml version="1.0" encoding="utf-8"?>
<level id="cirpachasflips" rversion="0.5.2">
	<info>
		<name>Cirpacha's tunnel vision</name>
		<description>playing with circles. from 2018</description>
		<author>Cirpacha</author>
		<date>2021-04-22</date>
		<sky>white</sky>
		<border texture="Black"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Flower" new_name="checkball"/>
		<sprite_replacement old_name="Wrecker" new_name="MetallicaWrecker"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="0.24" y="0.0" frontlayer="false"/>
		<layeroffset x="0.19" y="0.0" frontlayer="false"/>
		<layeroffset x="0.15" y="0.0" frontlayer="false"/>
		<layeroffset x="0.12" y="0.0" frontlayer="false"/>
		<layeroffset x="0.1" y="0.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-28.750000" right="28.750000" top="17.500000" bottom="-17.500000"/>
	<script>
-- playing with circles --

-- blocks --
-- pala1 --
-- flip1 .. flip4 --
-- hissi --

-- entities --
check1 = {}
check2 = {}
check3 = {}
check4 = {}
check5 = {}
check6 = {}

-- zones --
hissizone = {}
flipzone = {}

-- timers --
flipstoptimer = {}
hissistoptimer = {}

-- variables --
hissikaynnissa = false
flippy = false
fliplaskuri = 0

function OnLoad()
	Game.SetKeyHook("R", "tiputus")
	Game.SetKeyHook("T", "hissi")
	Game.SetBlockCenter("hissi", 0, 0)
	p1x, p1y = Game.GetBlockPos("pala1")
	f1x, f1y = Game.GetBlockPos("flip1")
	f2x, f2y = Game.GetBlockPos("flip2")
	f3x, f3y = Game.GetBlockPos("flip3")
	f4x, f4y = Game.GetBlockPos("flip4")
	hx, hy = Game.GetBlockPos("hissi")
	return true
end

function flipzone.OnEnter()
	flippy = true
end

function flipzone.Onleave()
	flippy = false
end

function tiputus()
	Game.SetBlockPos("pala1", -10, -10)
	return true
end

function OnSomersault()
	if (flippy == true)
	then
		fliplaskuri = fliplaskuri + 1
	end
	if fliplaskuri == 1
	then
		Game.SetDynamicBlockTranslation("flip1", -5, 0, 100, 0, 0)
		Game.StartTimer("flipstoptimer", 50, 1)
	end
	if fliplaskuri == 2
	then
		Game.SetDynamicBlockTranslation("flip2", -5, 0, 100, 0, 0)
		Game.StartTimer("flipstoptimer", 50, 1)
	end
	if fliplaskuri == 3
	then
		Game.SetDynamicBlockTranslation("flip3", -5, 0, 100, 0, 0)
		Game.StartTimer("flipstoptimer", 50, 1)
	end
	if fliplaskuri == 4
	then
		Game.SetDynamicBlockTranslation("flip4", -5, 0, 100, 0, 0)
		Game.StartTimer("flipstoptimer", 50, 1)
	end
	return true
end

function flipstoptimer.Tick()
	Game.SetDynamicBlockNone("flip1")
	Game.SetDynamicBlockNone("flip2")
	Game.SetDynamicBlockNone("flip3")
	Game.SetDynamicBlockNone("flip4")
	return true
end

function hissi()
	if Game.IsPlayerInZone("hissizone") and (hissikaynnissa == false)
	then
		hissikaynnissa = true
		Game.SetDynamicBlockTranslation("hissi", 0, 25.4, 8000, 0, 0)
		Game.StartTimer("hissistoptimer", 4000, 1)
	end
	return true
end

function hissistoptimer.Tick()
	Game.SetDynamicBlockNone("hissi")
	return true
end

-- checkpoints --
	function check1.OnUse()
		Game.SetBlockPos("hissi", hx, hy)
		checks()
		return true
	end

	function check2.OnUse()
		checks()
		return true
	end

	function check3.OnUse()
		checks()
		return true
	end

	function check4.OnUse()
		checks()
		return true
	end

	function check5.OnUse()
		checks()
		return true
	end

	function check6.OnUse()
		checks()
	end

	function checks()
		hissikaynnissa = false
		fliplaskuri = 0
		flippy = false
		Game.SetDynamicBlockNone("hissi")
		Game.SetDynamicBlockNone("flip1")
		Game.SetDynamicBlockNone("flip2")
		Game.SetDynamicBlockNone("flip3")
		Game.SetDynamicBlockNone("flip4")
		Game.SetBlockPos("pala1", p1x, p1y)
		Game.SetBlockPos("flip1", f1x, f1y)
		Game.SetBlockPos("flip2", f2x, f2y)
		Game.SetBlockPos("flip3", f3x, f3y)
		Game.SetBlockPos("flip4", f4x, f4y)
		return true
	end	
-------------------
	</script>
