<?xml version="1.0" encoding="utf-8"?>
<level id="cirpachasbeerfear2" rversion="0.5.2">
	<info>
		<name>Cirpacha's beer fear</name>
		<description>after a long night partying and barely getting any sleep, you cant decide whether to never touch another drink or to start the day with a pick-me-up. from 2018</description>
		<author>Cirpacha</author>
		<date>2018-03-01</date>
		<sky>white</sky>
		<border texture="Black"/>
		<music name="SpeedItUp" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Flower" new_name="beerleft"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
	</layeroffsets>
	<limits left="-5.000000" right="5.000000" top="3.000000" bottom="-3.000000"/>
	<script>
-- Cirpacha's beer fear --

-- stones &lt;size width="3.66" r="1.4" height="4.9"/&gt;
--        &lt;size width="2.5" r="1" height="4.9"/&gt;

-- entities --
wreck1 = {}
wreck2 = {}
wreck3 = {}
wreck4 = {}
tappo1 = {}
tappo2 = {}
tappo3 = {}
tappo4 = {}
tappo5 = {}
tappo6 = {}
sprite1 = {}
sprite2 = {}
sprite3 = {}
sprite4 = {}
sprite5 = {}
sprite6 = {}
sprite7 = {}
kaljaa = {}
beerflare = {}

-- blocks --
-- kaljab --
-- keski --
-- ylapala --

-- timers --
blok1 = {}
tappotimer = {}
alkuviestit = {}
viestidiffic = {}
ohje = {}
normalvoitto = {}
hardvoitto = {}

-- variables --
valinta = 2
muisti = 2
saavalita = 0
normal = 0
hard = 0
laskuri = 0


function OnLoad()
	Game.StartTimer("alkuviestit", 50, 1)
	Game.CameraZoom(-0.03)
	Game.SetBlockCenter("ylapala", 0, 0)
	Game.SetBlockCenter("keski", 0, 0)
	Game.SetBlockCenter("kaljab", 0, 0)
	Game.SetBlockPos("kaljab", 5, 1.5)
	Game.SetKeyHook("N", "normalinit")
	Game.SetKeyHook("H", "hardinit")
	return true
end

function normalinit()
	if hard == 0 and normal == 0 and saavalita == 1
	then
		normal = 1
		Game.SetBlockPos("ylapala", 5, 8.9)
		Game.Message("you chose normal")
		Game.StartTimer("blok1",500,10)
		Game.StartTimer("ohje", 150, 1)
	end
	return true
end

function hardinit()
	if normal == 0 and hard == 0 and saavalita == 1
	then
		hard = 1
		Game.Message("you chose hard")
		Game.SetBlockPos("keski", 5, 8.6)
		Game.StartTimer("ohje", 100, 1)
		Game.StartTimer("blok1", 430, 11)
		Game.SetEntityPos("wreck1", 2, 0)
		Game.SetEntityPos("wreck2", 1.7, 0)
		Game.SetEntityPos("wreck3", -1.7, 0)
		Game.SetEntityPos("wreck4", -2, 0)
	end
	return true
end

function blok1.Tick()
	while(valinta == muisti)
	do
		valinta = math.random(1, 6)
	end
	muisti = valinta
	paikka = "sprite" .. valinta
	sx, sy = Game.GetEntityPos(paikka)
	bx, by = Game.GetEntityPos("beerflare")
	kx, ky = Game.GetBlockPos("kaljab")
	aika = Game.GetTime()
	Game.SetDynamicBlockTranslation("kaljab", sx-kx+5, sy-ky, 500, aika, aika+250)
	Game.SetDynamicEntityTranslation("beerflare", sx-bx, sy-by, 500, aika, aika+250)
	if normal == 1
	then
		Game.StartTimer("tappotimer", 250, 1)
	else
		Game.StartTimer("tappotimer", 250, 1)
	end
	laskuri = laskuri + 1
	if laskuri == 10 and normal == 1
	then
		Game.StartTimer("normalvoitto", 600, 1)
	end
	if laskuri == 11 and hard == 1
	then
		Game.StartTimer("hardvoitto", 600, 1)
	end
	return true
end

function tappotimer.Tick()
	i = 1
	taika = Game.GetTime()
	turva = 7 - valinta
	while(i &lt; turva)
	do
		if(i &lt; 4)
		then
			Game.SetDynamicEntityTranslation("tappo" .. i, 0, -3, 200, taika, taika+100)
			Game.SetDynamicEntityTranslation("tappo" .. i, 0, 3, 200, taika+200, taika+300)
		else
			Game.SetDynamicEntityTranslation("tappo" .. i, 0, 3, 200, taika, taika+100)
			Game.SetDynamicEntityTranslation("tappo" .. i, 0, -3, 200, taika+200, taika+300)
		end
		i = i + 1
	end
	if(turva &lt; 6)
	then
		i = 1
		while(turva+i &lt; 7)
		do
			if(turva+i &lt; 4)
			then
				Game.SetDynamicEntityTranslation("tappo" .. turva+i, 0, -3, 200, taika, taika+100)
				Game.SetDynamicEntityTranslation("tappo" .. turva+i, 0, 3, 200, taika+200, taika+300)
			else
				Game.SetDynamicEntityTranslation("tappo" .. turva+i, 0, 3, 200, taika, taika+100)
				Game.SetDynamicEntityTranslation("tappo" .. turva+i, 0, -3, 200, taika+200, taika+300)
			end
			i = i + 1
		end
	end
	return true
end

function normalvoitto.Tick()
	Game.Message("go get your beer!")
	Game.SetEntityPos("kaljaa", sx, sy)
	Game.SetBlockPos("kaljab", -10, -10)
	return true
end

function hardvoitto.Tick()
	Game.Message("congratulations! go get your beer!")
	Game.SetEntityPos("kaljaa", sx, sy)
	Game.SetBlockPos("kaljab", -10, -10)
	return true
end

function alkuviestit.Tick()
	Game.Message("welcome to my minigame")
	Game.StartTimer("viestidiffic", 150, 1)
	return true
end

function viestidiffic.Tick()
	Game.Message("select the difficulty by pressing either N=normal or H=hard")
	saavalita = 1
	return true
end

function ohje.Tick()
	Game.Message("go to the square opposite to the beer glass")
	return true
end

-- stones --
	function tappo1.Touch()
		Game.KillPlayer()
		return true
	end

	function tappo2.Touch()
		Game.KillPlayer()
		return true
	end

	function tappo3.Touch()
		Game.KillPlayer()
		return true
	end

	function tappo4.Touch()
		Game.KillPlayer()
		return true
	end

	function tappo5.Touch()
		Game.KillPlayer()
		return true
	end

	function tappo6.Touch()
		Game.KillPlayer()
		return true
	end
----
	</script>
