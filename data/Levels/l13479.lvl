<?xml version="1.0" encoding="utf-8"?>
<level id="sefeshortalpine" rversion="0.5.2">
	<info>
		<name>SeFe - Short #1 - Alpine</name>
		<description>A little adventure in the Alps... ;)</description>
		<author>SeFe</author>
		<date>2014-03-18</date>
		<sky color_g="65" color_b="117" zoom="20.0" color_a="255" offset="0.0" color_r="38">DarkSky</sky>
		<border texture="invisible"/>
		<music name="SpeedItUp" />
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-20.000000" right="20.000000" top="15.000000" bottom="-9.000000"/>
	<script>
kzone = {}
sprite = {}
sprite0 = {}
lighten = {}
tree = {}
gras = {}
timer = {}
check = 0
x,y = 0,0
x2,y2 = 0,0

function kzone.OnEnter()
Game.KillPlayer()
end

function sprite.Touch()
x,y = Game.GetEntityPos("lighten")
Game.SetPlayerPosition(x,y,0)
end

function sprite0.Touch()
Game.WinPlayer()
Game.Message("Nice!")
end


function tree.Touch()
if check == 0 then
Game.Message("Hmmm... How can I go pass that tree?")
Game.StartTimer("timer",500,1)
check = 1
end
end

function timer.Tick()
x2,y2 = Game.GetEntityPos("gras")
Game.Message("What the hell!?")
Game.SetPlayerPosition(x2,y2,0)	
end
	</script>
