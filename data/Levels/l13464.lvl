<?xml version="1.0" encoding="utf-8"?>
<level id="Sunshineloliconsandrainbowstoo" rversion="0.5.2">
	<info>
		<name>Sunshine, Lollipops and Rainbows Too</name>
		<description>If you actually get this bad for you.</description>
		<author>Make</author>
		<date>2014-03-05</date>
		<sky BlendTexture="sky1" driftZoom="20.0" zoom="20.0" drifted="true">sky1</sky>
		<border texture="invisible"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="smiley"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.02" y="0.02" frontlayer="false"/>
		<layeroffset x="0.04" y="0.03" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-27.509000" right="27.509000" top="18.602362" bottom="-18.602362"/>
	<script>

---Seriously, cheating the secrets from here is no cool.---


fucks = 0
point = 0
D1 = {}
D2 = {}
D3 = {}
fakeend = {}


function OnLoad()
	Game.SetKeyHook("6","smile")
	x1, y1 = Game.GetEntityPos("normaltree")
	x2, y2 = Game.GetEntityPos("creepytree")
return true 
end

---teleporting to gameplay-wise identical place with similar coordinates---


function smile()
	fucks = fucks+1
	if fucks == 3 then
		x,y = Game.GetPlayerPosition()
		xdif = x-x1
		ydif = y-y1
		Game.SetPlayerPosition(x2+xdif, y2+ydif, 0)
		Game.CameraZoom(-0.05)
	end
	if fucks == 6 then
		Game.KillPlayer()
		Game.Message("Too greedy.")
	end
end

---faking berries with sprites---


function D1.Touch()
	point = point + 1
	Game.KillEntity("D1")
	Game.Message(""..point.." out of 3")
end
function D2.Touch()
	point = point + 1
	Game.KillEntity("D2")
	Game.Message(""..point.." out of 3")
end
function D3.Touch()
	point = point + 1
	Game.KillEntity("D3")
	Game.Message(""..point.." out of 3")
end

function fakeend.Touch()
	if point == 3 then
		Game.WinPlayer()
	end
end
	</script>
