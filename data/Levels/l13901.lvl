<?xml version="1.0" encoding="utf-8"?>
<level id="cirpachascorroded" rversion="0.5.2">
	<info>
		<name>Cirpacha's corroded land</name>
		<description>from 2013</description>
		<author>Cirpacha</author>
		<date>2018-01-09</date>
		<sky driftColor_b="30" BlendTexture="sky2" driftColor_g="41" zoom="0.5" driftColor_r="113" driftColor_a="255" drifted="true">invisible</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="0.04" y="0.04" frontlayer="false"/>
		<layeroffset x="0.04" y="0.04" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.11" y="1.11" frontlayer="true"/>
	</layeroffsets>
	<limits left="-32.500000" right="32.500000" top="20.000000" bottom="-20.000000"/>
	<script>
-- Cirpacha's corroded land --

-- entities --
teleportfrom = {}
teleportto = {}

-- timers --
messages = {}
voittotimer = {}

-- booleans --
yksi = 0
kaksi = 0
kolme = 0
nelja = 0
voitto = 0

function OnLoad()
	ix, iy = Game.GetEntityPos("teleportto")
	return true
end

function teleportfrom.Touch()
	Game.SetPlayerPosition(ix, iy, -1)
	Game.StartTimer("messages", 450, 5)
	return true
end

function messages.Tick()
	if voitto == 1
	then
		Game.AddPenaltyTime(60.00)
		Game.StartTimer("voittotimer", 50, 1)
	end
	if nelja == 1
	then
		Game.Message("clinging to the past that never was")
		nelja = 0
		voitto = 1
	end	
	if kolme == 1
	then
		Game.Message("felt trapped in a bubble where time has stopped")
		kolme = 0
		nelja = 1
	end
	if kaksi == 1
	then
		Game.Message("like there's nothing you can recognize")
		kaksi = 0
		kolme = 1
	end	
	if yksi == 0
	then
		Game.Message("ever felt completely lost in your surroundings")
		yksi = 1
		kaksi = 1
	end
	return true
end

function voittotimer.Tick()
	Game.WinPlayer()
	return true
end
	
	</script>
