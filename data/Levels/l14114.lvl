<?xml version="1.0" encoding="utf-8"?>
<level id="BRICKEDUP2" rversion="0.2.7">
	<info>
		<name>Two Brick Roads</name>
		<description>20th anniversary?</description>
		<author>pishi</author>
		<date>2025-05-28</date>
		<sky>sky2</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
	</layeroffsets>
	<limits left="-112.500000" right="112.500000" top="62.500000" bottom="-62.500000"/>
	<script>
strawberry1 = {}
x = true

function strawberry1.Touch()
  Game.Message("The path has been opened!")
  Game.SetDynamicBlockTranslation("brick", 0, 10000, 10000, 0, 100 + (10000 / 2))
  x = false
end

zone = {}

function zone.OnEnterBy(player)
  if x == true then
    Game.Message("You need the other strawberry first!")
  end
end

function OnLoad()
  Game.Message("Open the second path by getting a strawberry!")
  return true
end
	</script>
