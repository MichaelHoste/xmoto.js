function OnLoad()
	Game.CameraZoom(-0.162)
	Game.CameraMove(22, -22)
	Game.SetKeyHook("W", "up")
	Game.SetKeyHook("A", "left")
	Game.SetKeyHook("S", "down")
	Game.SetKeyHook("D", "right")
	Game.SetKeyHook("C", "change")
	Game.SetKeyHook("F", "start")
	Game.SetKeyHook("H", "info")
	Game.Message("Welcome to my level...")
	Game.Message("In this lvl you have to build the level by yourself!")
	Game.Message("Move the blocks with WASD and change the block with C.")
	Game.Message("When your level is finished, then press F to play it.")
	Game.Message("Now hurry up - time is running!")
	Game.Message("Press H to show this again.")
check0 = 1
return true
end



function up()
if check0 == 1 then
  x, y = Game.GetBlockPos("block0")
  Game.SetBlockPos("block0", x, y + 1)
Game.SetBlockPos("white0", x, y + 1)
else
if check1 == 1 then
  x, y = Game.GetBlockPos("block1")
  Game.SetBlockPos("block1", x, y + 1)
Game.SetBlockPos("white1", x, y + 1)
else
if check2 == 1 then
  x, y = Game.GetBlockPos("block2")
  Game.SetBlockPos("block2", x, y + 1)
Game.SetBlockPos("white2", x, y + 1)
else
if check3 == 1 then
  x, y = Game.GetBlockPos("block3")
  Game.SetBlockPos("block3", x, y + 1)
Game.SetBlockPos("white3", x, y + 1)
else
if check4 == 1 then
  x, y = Game.GetBlockPos("block4")
  Game.SetBlockPos("block4", x, y + 1)
Game.SetBlockPos("white4", x, y + 1)
else
if check5 == 1 then
  x, y = Game.GetBlockPos("block5")
  Game.SetBlockPos("block5", x, y + 1)
Game.SetBlockPos("white5", x, y + 1)
else
if check6 == 1 then
  x, y = Game.GetBlockPos("block6")
  Game.SetBlockPos("block6", x, y + 1)
Game.SetBlockPos("white6", x, y + 1)
else
if check7 == 1 then
  x, y = Game.GetBlockPos("block7")
  Game.SetBlockPos("block7", x, y + 1)
Game.SetBlockPos("white7", x, y + 1)
else
if check8 == 1 then
  x, y = Game.GetBlockPos("block8")
  Game.SetBlockPos("block8", x, y + 1)
Game.SetBlockPos("white8", x, y + 1)
end
end
end
end
end
end
end
end
end
end



