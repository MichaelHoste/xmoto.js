<?xml version="1.0" encoding="utf-8"?>
<level id="serebuildyourlevel1" rversion="0.5.2">
	<info>
		<name>SeRe - Build your level #1</name>
		<description>Welcome to my "Build your Level" series... Scripted and made by Sere. Have fun! :D</description>
		<author>SeRe</author>
		<date>2014-02-27</date>
		<sky drifted="true"></sky>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-40.000000" right="40.000000" top="30.000000" bottom="-30.000000"/>
	<script>


---Sorry for that messy script, but in my opinion a WORKING script is a GOOD script :P---
	-----------Script made by SeRe (Save Urin)-----------
		-----------15.02.2014-----------



---blocks---

stop0 = {}
