if check0 == 1 then
  x, y = Game.GetBlockPos("block0")
  Game.SetBlockPos("block0", x - 1, y)
Game.SetBlockPos("white0", x - 1, y)
else
if check1 == 1 then
  x, y = Game.GetBlockPos("block1")
  Game.SetBlockPos("block1", x - 1, y)
