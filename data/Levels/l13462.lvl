function change()
if check0 == 1 then
	if check0 == 1 and changecheck0 == 0 then
	Game.MoveBlock("block1", 132, 0)
	end
		Game.MoveBlock("white1", 132, 0)
		Game.MoveBlock("white0", -132, -0)
changecheck0 = 1
check0 = 0
check1 = 1
else
if check1 == 1 then
	if check1 == 1 and changecheck1 == 0 then
	Game.MoveBlock("block2", 132, 0)
	changecheck1 = 1
	end
		Game.MoveBlock("white2", 132, 0)
		Game.MoveBlock("white1", -132, -0)
check1 = 0
check2 = 1
else
if check2 == 1 then
	if check2 == 1 and changecheck2 == 0 then
	Game.MoveBlock("block3", 132, 0)
	changecheck2 = 1
	end
		Game.MoveBlock("white3", 132, 0)
		Game.MoveBlock("white2", -132, -0)
check2 = 0
check3 = 1
else
if check3 == 1 then
	if check3 == 1 and changecheck3 == 0 then
	Game.MoveBlock("block4", 132, 0)
	changecheck3 = 1
	end
		Game.MoveBlock("white4", 132, 0)
		Game.MoveBlock("white3", -132, -0)
check3 = 0
check4 = 1
else
if check4 == 1 then
	if check4 == 1 and changecheck4 == 0 then
	Game.MoveBlock("block5", 132, 0)
	changecheck4 = 1
	end
		Game.MoveBlock("white5", 132, 0)
		Game.MoveBlock("white4", -132, -0)
check4 = 0
check5 = 1
else
if check5 == 1 then
	if check5 == 1 and changecheck5 == 0 then
	Game.MoveBlock("block6", 132, 0)
	changecheck5 = 1
	end
		Game.MoveBlock("white6", 132, 0)
		Game.MoveBlock("white5", -132, -0)
check5 = 0
check6 = 1
else
if check6 == 1 then
	if check6 == 1 and changecheck6 == 0 then
	Game.MoveBlock("block7", 132, 0)
	changecheck6 = 1
	end
		Game.MoveBlock("white7", 132, 0)
		Game.MoveBlock("white6", -132, -0)
check6 = 0
check7 = 1
else
if check7 == 1 then
	if check7 == 1 and changecheck7 == 0 then
	Game.MoveBlock("block8", 132, 0)
	changecheck7 = 1
	end
		Game.MoveBlock("white8", 132, 0)
		Game.MoveBlock("white7", -132, -0)
check7 = 0
check8 = 1
else
if check8 == 1 then
	Game.MoveBlock("white0", 132, 0)
	Game.MoveBlock("white8", -132, -0)
check8 = 0
check0 = 1
end
end
end
end
end
end
end
end
end
end







function start()
if fcheck == 0 then
Game.MoveBlock("white0", -1000, -0)
Game.MoveBlock("white1", -1000, -0)
Game.MoveBlock("white2", -1000, -0)
Game.MoveBlock("white3", -1000, -0)
Game.MoveBlock("white4", -1000, -0)
Game.MoveBlock("white5", -1000, -0)
Game.MoveBlock("white6", -1000, -0)
Game.MoveBlock("white7", -1000, -0)
Game.MoveBlock("white8", -1000, -0)
Game.SetBlockPos("stop0", 500, 0)
Game.SetBlockPos("stop1", 500, 0)
Game.SetBlockPos("stop2", 500, 0)
Game.SetBlockPos("stop3", 500, 0)
Game.SetBlockPos("stop4", 500, 0)
check0 = 0
check1 = 0
check2 = 0
check3 = 0
check4 = 0
check5 = 0
check6 = 0
check7 = 0
check8 = 0
Game.CameraZoom(0.162)
Game.CameraMove(-22, 22)
fcheck = 1
end
end

function info()
	Game.Message("Welcome to my level...")
	Game.Message("In this lvl you have to build the level by yourself!")
	Game.Message("Move the blocks with WASD and change the block with C.")
	Game.Message("When your level is finished, then press F to play it.")
	Game.Message("Now hurry up - time is running!")
end



function segr.Touch()
	if secheck == 0 then
		Game.SetBlockPos("sebl", 1000, 1000)
		Game.KillEntity("segr")
		Game.Message("What's that? - A hidden cave?!")
	secheck = 1
end
end

function se.Touch()
	x,y = Game.GetEntityPos("lighten")
		Game.SetPlayerPosition(x,y,0)
end

function semes.Touch()
	if secheck0 == 0 then
		Game.Message("There is a treasure, on the mountain  - or is it just a fata morgana?! :o")
	secheck0 = 1
end
end

function sesp.Touch()
	if secheck1 == 0 then
		Game.SetBlockPos("sebl0", 1000, 1000)
		Game.Message("It's real, but I can't go any further, but maybe I can go through the mountain...")
	secheck1 = 1
end
end

function segr0.Touch()
	if secheck2 == 0 then
		Game.Message("Water and berries :o - it's  paradise :D")
		Game.StartTimer("timer",250 ,1)
		Game.StartTimer("timer0",400 ,1)
	secheck2 = 1
end
end




function timer.Tick()
	Game.Message("Oh the berries were poisonous, I feel sick...")
end


function timer0.Tick()
	Game.KillPlayer()
end







