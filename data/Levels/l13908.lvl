<?xml version="1.0" encoding="utf-8"?>
<level id="davidtrick02u" rversion="0.5.2">
	<info>
		<name>David - Trick 2 - Easy</name>
		<description>I am a fan of Cirpy.</description>
		<author>David</author>
		<date>2018-02-22</date>
		<sky color_g="0" color_b="142" zoom="0.5" color_a="255" color_r="0">sky1</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-17.267888" right="17.267888" top="12.151808" bottom="-12.151808"/>
	<script>
v = 0;

l = 0
i = 0
f = 0 
e = 0


r1 = {}
r2 = {}
r3 = {}
r4 = {}
r5 = {}
r6 = {}

t1 = {}
t2 = {}
t3 = {}
t4 = {}

lock = 0
deathzone = {}

function OnLoad()
Game.Message("H for help")
Game.SetKeyHook("d", "MoveBlock")
Game.SetKeyHook("h", "Help")
Game.SetKeyHook("l", "Type")
return true;
end

function MoveBlock()
if(v==0)
then
v = 1
Game.SetDynamicBlockTranslation("moving", 0, 5, 300, 0, 30)
end
return true
end

function Help()
  Game.Message("Press D to move the lift upwards. ");
  Game.Message("Level made by david.hk");
end

function deathzone.OnEnter()
    Game.KillPlayer()
end


function Type()
if(lock == 1) then return end
if(l == 0) then 
l=1
Game.Message('l')
elseif (i == 0) 
then i=1 Game.Message('i')
elseif(f == 0) 
then f=1 Game.Message('f')
elseif(e == 0) 
then 
Game.Message("e")
lock = 1
ToggleTeleport() 
end
end

function ToggleTeleport()
Game.SetKeyHook(Game.GetKeyByActionTech("ChangeDirection"), "Kill")
Game.SetPlayerPosition(-14.40277175, -43.23942485, 1)
end


function r1.OnEnter()
    Game.Message("Imagine your life goes straight...")
end


function r2.OnEnter()
    Game.Message("You experience up and downs everyday...")
end

function r3.OnEnter()
    Game.Message("You live a normal life just like everyone else does...")
end

function r4.OnEnter()
    Game.Message("Suddenly...")
end

function r5.OnEnter()
    Game.Message("Everything becomes different...")
end

function r6.OnEnter()
    Game.MoveBlock("sup", 100, 100)
    Game.StartTimer("t1",1000,1)
end

function t1.Tick()
Game.Message("You fall into a place full of nothing...")
Game.StartTimer("t2",1000,1)
end

function t2.Tick()
Game.Message("You are totally on your own... Nothing and nobody can help you out...")
Game.StartTimer("t3",1000,1)
end

function t3.Tick()
Game.Message("Until you realize the reality hit you.")
Game.StartTimer("t4",1300,1)
end


function t4.Tick()
Game.KillPlayer()
end

function Kill()
Game.KillPlayer()
end
	</script>
