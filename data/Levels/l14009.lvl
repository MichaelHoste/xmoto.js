<?xml version="1.0" encoding="utf-8"?>
<level id="gniniartsorea01test" rversion="0.5.2">
	<info>
		<name>Gniniart Sorea #01</name>
		<description>a reimagining of a classic level</description>
		<author>Cirpacha</author>
		<date>2021-06-15</date>
		<sky color_g="89" color_b="1" zoom="2.5" color_a="255" color_r="182">Sky3</sky>
		<border texture="DarkFrostGround"/>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-13.125000" right="13.125000" top="6.125000" bottom="-6.125000"/>
	<script>
-- blocks:
-- flowerpetals
-- flowercenter

function OnLoad()
	Game.SetBlockCenter("flowerpetals", 0, 0)
	Game.SetBlockCenter("flowercenter", 0, 0)
	Game.SetDynamicBlockRotation("flowerpetals", -math.pi/2, 0.02, 300, 0, 0)
	Game.SetDynamicBlockRotation("flowercenter", -math.pi/2, 0.02, 300, 0, 0)
	Game.SetDynamicBlockTranslation("flowerpetals", 0.04, 0.02, 50, 0, 0)
	Game.SetDynamicBlockTranslation("flowercenter", 0.04, 0.02, 50, 0, 0)
return true
end

function Tick()
	x, y, fa = Game.GetPlayerPosition()
	if fa == 1 then
		Game.SetPlayerPosition(8.03944575, -5.1059623, 1)
		Game.Message("!dnuora nrut ton oD")
	end
	return true
end
	</script>
