<?xml version="1.0" encoding="utf-8"?>
<level id="serewheelietraining" rversion="0.5.2">
	<info>
		<name>SeRe - Wheelie Training</name>
		<description>Let's see how you're doing at Wheelies! Boss Challenge: Finish without changing direction! Good Luck, SeRe.</description>
		<author>SeRe</author>
		<date>2015-02-05</date>
		<sky driftColor_b="117" BlendTexture="Cherrywood" driftColor_g="40" driftZoom="0.8" color_g="21" driftColor_a="255" color_a="255" color_b="109" driftColor_r="0" drifted="true" color_r="0">Sky3</sky>
		<border texture="invisible"/>
		<music name="batcave" />
	</info>
	<layeroffsets>
		<layeroffset x="0.04" y="0.04" frontlayer="false"/>
		<layeroffset x="0.04" y="0.04" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
	</layeroffsets>
	<limits left="-12.500000" right="12.500000" top="10.000000" bottom="-10.000000"/>
	<script>
b0 = {}
b1 = {}
b2 = {}
b3 = {}
b4 = {}
e = 0 -- how often the zone was entered
bc = 0 --- means berries collected
zone = {}
x, y = 0, 0
px, py, bright = 0, 0, 0
block0 = {}
block1 = {}
block2 = {}
block3 = {}
timer = {}
flipped = 0


function OnLoad()
Game.Message("Welcome to my Wheelie Training.")
Game.Message("Drive out of the cave and get the berry!")
x, y = Game.GetEntityPos("b0")
return 1
end

function b0.Touch()
Game.Message("Nice, now go back!")
bc=1
end

function b1.Touch()
bc=2
end

function b2.Touch()
bc=3
end

function b3.Touch()
bc=4
end

function b4.Touch()
Game.Message("Last Berry!")
bc=5
end


function zone.OnEnter()
if e==0 and bc==1 then
Game.SetEntityPos("b1", x, y)
Game.Message("You did it, let's make it harder...")
Game.SetBlockPos("block0", 9.40452275, 14.63038725)
e=1
end
if e==1 and bc==2 then
Game.SetEntityPos("b2", x, y)
Game.Message("Nice, let's get to 'Kind of difficult'! :P")
Game.SetBlockPos("block1", 9.6378225, 14.731627)
Game.SetBlockPos("block0", 9.40452275, 1400.63038725)
e=2
end
if e==2 and bc==3 then
Game.SetEntityPos("b3", x, y)
Game.Message("Great Job, now try this.")
Game.SetBlockPos("block2", 10.68683, 14.46909675)
Game.SetBlockPos("block1", 9.6378225, 1400.731627)
e=3
end
if e==3 and bc==4 then
Game.SetEntityPos("b4", x, y)
Game.Message("To finish the level you have to pass 'Very Difficult'")
Game.Message("Good Luck!")
Game.SetBlockPos("block3", 10.96484375, 13.3712567817)
Game.SetBlockPos("block2", 10.68683, 1400.46909675)
e=4
end
if e==4 and bc==5 and flipped==1 then
Game.Message("Awesome!")
Game.AddPenaltyTime(30)
Game.StartTimer("timer",1 ,1)
end
if e==4 and bc==5 and flipped==0 then
Game.Message("Boss!")
Game.WinPlayer()
end
end

 
function timer.Tick()
 Game.WinPlayer()
end


function Tick()

px, py, bright = Game.GetPlayerPosition()

if bright == 1	then
	
flipped = 1
end

return true

end

	</script>
