	<script>
wzone = {}
kzone = {}
kzone0 = {}
szone = {}
lighten5 = {}
gras = {}
gras0 = {}






function wzone.OnEnter()
		
		Game.WinPlayer()

end

function kzone.OnEnter()
        	
		Game.KillPlayer()

end

function kzone0.OnEnter()
        	
		Game.KillPlayer()

end

function szone.OnEnter()

	x, y = Game.GetEntityPos("lighten5")
	Game.SetPlayerPosition(x, y, 0)
	Game.Message("Enough from  modern, let's do some classic...")

end

function gras.Touch()

	Game.Message("You can't escape from here...")
	x, y = Game.GetEntityPos("lighten5")
	Game.SetPlayerPosition(x, y, 0)

end

function gras0.Touch()

	Game.Message("You can't escape from here...")
	x, y = Game.GetEntityPos("lighten5")
	Game.SetPlayerPosition(x, y, 0)	

end


	</script>
