zone0 = {}

zone1= {}

wrecker  = {}
finish = {}
lighten = {}
x , y = 0, 0
x1 , y1 = 0, 0



---checks--

check = 0

check0 = 0

check1 = 0

check2 = 0

check3 = 0

check4 = 0

check5 = 0

check6 = 0

check7 = 0

check8 = 0

check9 = 0

check10 = 0

check11 = 0

check12 = 0



---blocks xD---
block0 = {}
block1 = {}
block2 = {}
block3 = {}
block4 = {}
block5 = {}
block6 = {}
block7 = {}






function OnLoad()

check = 1
return true

end



function zone1.OnEnter()

if check0 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check0 = 0

check1 = 1

else

if check2 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check2 = 0

check3 = 1

else
if check4 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check4 = 0

check5 = 1

else

if check6 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check6 = 0

check7 = 1
else

if check8 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check8 = 0

check9 = 1
else

if check10 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check10 = 0

check11 = 1
else
if check12 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.KillEntity("wrecker")
Game.SetEntityPos("finish", x, y + 0.2)

check12 = 0

end
end
end

end

end
end

end
end





function zone0.OnEnter()
if check == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check = 0

check0 = 1

else


if check1 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check1 = 0

check2 = 1

else

if check3 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check3 = 0

check4 = 1
else
if check5 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check5 = 0

check6 = 1

else

if check7 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check7 = 0

check8 = 1

else

if check9 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check9 = 0

check10 = 1

else

if check11 == 1 then

x, y = Game.GetEntityPos("wrecker")

Game.SetEntityPos("wrecker", x, y + 0.2)

check11 = 0

check12 = 1
end
end
end

end

end
end

end
end



function finish.Touch()
Game.WinPlayer()
end


function OnSomersault()
Game.Message("Nice! Now try how long you can stay here without getting sick...")
x1,y1 = Game.GetEntityPos("lighten")
Game.SetPlayerPosition(x1,y1,0)
Game.SetDynamicBlockRotation("block0", math.rad(360) , 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block1", math.rad(360), 3, 5, 0, 0) 
Game.SetDynamicBlockRotation("block2", math.rad(360), 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block3", math.rad(360), 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block4", math.rad(360), 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block5", math.rad(360), 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block6", math.rad(360), 3, 5, 0, 0)
Game.SetDynamicBlockRotation("block7", math.rad(360), 3, 5, 0, 0)
end

