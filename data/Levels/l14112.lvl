<?xml version="1.0" encoding="utf-8"?>
<level id="sefewreckertraining" rversion="0.5.2">
	<info>
		<name>SeFe - Wrecker Training</name>
		<description>Wreckers are placed to make it impossible to go to specific areas. One should not be able to pass them.            ...We broke the rules...</description>
		<author>SeFe</author>
		<date>2014-08-04</date>
		<sky>Black</sky>
		<border texture="invisible"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Wrecker" new_name="YellowFlare"/>
	</theme_replacements>
	<limits left="-5.67" right="5.18" top="0.3" bottom="-4.428750"/>
	<script>
------------------------------------Script made by SeRe (Save Urin)----------------------------------
------------------------------------------02.03.2014-15.03.2014---------------------------------------

--------------oooooooooo--------------
--------------o-----------------------
