<?xml version="1.0" encoding="utf-8"?>
<level id="seretheflash" rversion="0.5.2">
	<info>
		<name>SeRe - The Flash</name>
		<description>I hope you like the level, even if some of tricks are annoying. Don't get flashed by the colours! Good Luck! Made by SeRe. Merry christmas to all players! :) The 19th Level of the Xmoto Advent Calendar 2014.</description>
		<author>SeRe</author>
		<date>2014-12-19</date>
		<sky color_g="244" color_b="255" color_a="255" color_r="0">white</sky>
		<border texture="invisible"/>
		<music name="blockolando" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Flower" new_name="checkball"/>
		<sprite_replacement old_name="Strawberry" new_name="crossthingy"/>
		<sprite_replacement old_name="Wrecker" new_name="smiley"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.57" y="1.57" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-11.250000" right="11.250000" top="9.250000" bottom="-9.250000"/>
	<script>
block = {}
block1 = {}

function OnLoad()
Game.Message("For the flash press F!")
Game.Message("Merry Christmas to all players!")
Game.SetKeyHook("F","flash")
Game.SetDynamicBlockTranslation("block", 20, -550, 150000, 0, 0)
return true
end

function flash()
Game.SetBlockPos("block1", 2000, 2000)
Game.SetBlockPos("block", 200000, 200000)
end
	</script>
