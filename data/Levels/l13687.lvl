	<info>
		<name>Unknow - Naturally Grew</name>
		<description></description>
		<author>Unknow~</author>
		<date>2014-08-24</date>
		<sky>sky1</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-17.500000" right="17.500000" top="17.500000" bottom="-17.500000"/>
	<script>
--array of sprites
f = {f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15}
entityMoveTimer = {}

function OnLoad()
	--init sprites
	for i=0, 15 do
		f[i] = {}
	end
	--start movetimer
	Game.StartTimer("entityMoveTimer", 1, 0)
	return true
end

function entityMoveTimer.Tick()
	--move sprites randomly between -1 and 1
	for i = 0, 15 do
		moveEntity("f"..tostring(i), math.random(-1, 1)*0.03, math.random(-1, 1)*0.03)
	end
end

function moveEntity(entity, speedx, speedy)
	x, y = Game.GetEntityPos(entity)
	Game.SetEntityPos(entity, x+speedx, y+speedy)
end

	</script>
