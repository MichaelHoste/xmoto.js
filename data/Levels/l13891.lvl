--------------o---o-------------------
--------------o----o------------------
--------------o-----o-----------------






---blocks---
apple0 = {}
apple1 = {}
apple2 = {}
apple3 = {}
apple4 = {}
apple5 = {}
apple6 = {}
apple7 = {}
apple8 = {}

---berries---
stb0 = {}
stb1 = {}
stb2 = {}

---checkpoints---
cp0 = {}
cp1 = {}

---positions---
x0, y0 = 0, 0
x1, y1 = 0, 0
x2, y2 = 0, 0
x3, y3 = 0, 0
x4, y4 = 0, 0
x5, y5 = 0, 0
x6, y6 = 0, 0
x7, y7 = 0, 0
x8, y8 = 0, 0

---checks---
stb0check = 1
stb1check = 1
stb2check = 1


function OnLoad()
Game.Message("This year the crop is really bad,")
Game.Message("there are only three apples on this apple tree.")
Game.Message("You have to collect them.")
x0, y0 = Game.GetBlockPos("apple0")
x1, y1 = Game.GetBlockPos("apple1")
x2, y2 = Game.GetBlockPos("apple2")
x3, y3 = Game.GetBlockPos("apple3")
x4, y4 = Game.GetBlockPos("apple4")
x5, y5 = Game.GetBlockPos("apple5")
x6, y6 = Game.GetBlockPos("apple6")
x7, y7 = Game.GetBlockPos("apple7")
x8, y8 = Game.GetBlockPos("apple8")
return 1
end


function stb0.Touch()
Game.SetBlockPos("apple0", 1000, 1000)
Game.SetBlockPos("apple1", 1000, 1000)
Game.SetBlockPos("apple2", 1000, 1000)
stb0check = 1
end

function stb1.Touch()
Game.SetBlockPos("apple3", 1000, 1000)
Game.SetBlockPos("apple4", 1000, 1000)
Game.SetBlockPos("apple5", 1000, 1000)
stb1check = 1
end

function stb2.Touch()
Game.SetBlockPos("apple6", 1000, 1000)
Game.SetBlockPos("apple7", 1000, 1000)
Game.SetBlockPos("apple8", 1000, 1000)
stb2check = 1
end

function cp0.OnUse()
if stb0check == 1 and Game.RemainingStrawberries() == 3 then
Game.SetBlockPos("apple0", x0, y0)
Game.SetBlockPos("apple1", x1, y1)
Game.SetBlockPos("apple2", x2, y2)
end
end

function cp1.OnUse()
if stb1check == 1 and Game.RemainingStrawberries() == 2 then
Game.SetBlockPos("apple3", x3, y3)
Game.SetBlockPos("apple4", x4, y4)
Game.SetBlockPos("apple5", x5, y5)
end
if stb1check == 1 and stb2check == 1 and Game.RemainingStrawberries() == 2 then
Game.SetBlockPos("apple3", x3, y3)
Game.SetBlockPos("apple4", x4, y4)
Game.SetBlockPos("apple5", x5, y5)
Game.SetBlockPos("apple6", x6, y6)
Game.SetBlockPos("apple7", x7, y7)
Game.SetBlockPos("apple8", x8, y8)
end
if  stb2check == 1 and Game.RemainingStrawberries() == 2 then
Game.SetBlockPos("apple6", x6, y6)
Game.SetBlockPos("apple7", x7, y7)
Game.SetBlockPos("apple8", x8, y8)
end
end
	</script>
