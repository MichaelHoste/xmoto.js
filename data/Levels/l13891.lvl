<?xml version="1.0" encoding="utf-8"?>
<level id="seretheappletree" rversion="0.5.2">
	<info>
		<name>SeRe - The Apple Tree</name>
		<description>This year the crop is really bad, there are only three apples on this apple tree. You have to collect them. Made by SeRe. Have fun! :)</description>
		<author>SeRe</author>
		<date>2014-06-20</date>
		<sky zoom="3.6">sky1</sky>
		<border texture="invisible"/>
		<music name="batcave" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="YellowFlare"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
	</layeroffsets>
	<limits left="-33.750000" right="33.750000" top="28.750000" bottom="-28.750000"/>
	<script>
------------------------------------Script made by SeRe (Save Urin)----------------------------------
-----------------------------------------20.05.2014-21.05.2014---------------------------------------

--------------oooooooooo--------------
--------------o-----------------------
--------------o-----------------------
--------------o-----------------------
--------------o-----------------------
--------------oooooooooo--------------
--------------o--------o--------------
--------------o--------o--------------
--------------o--------o--------------
--------------o--------o--------------
--------------oooooooooo--------------
--------------oo----------------------
--------------o-o---------------------
