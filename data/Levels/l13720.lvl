<?xml version="1.0" encoding="utf-8"?>
<level id="Basic_Halloween" rversion="0.5.2">
	<info>
		<name>Basic - Halloween</name>
		<description>Touchpad serisouly is not good at drawing</description>
		<author>tumo</author>
		<date>2014-10-23</date>
		<sky>Black</sky>
		<border texture="invisible"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="ring"/>
		<sprite_replacement old_name="Wrecker" new_name="eyesindark"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="0.0" y="0.0" frontlayer="true"/>
		<layeroffset x="0.0" y="0.0" frontlayer="true"/>
		<layeroffset x="2.0" y="2.0" frontlayer="true"/>
		<layeroffset x="2.0" y="2.0" frontlayer="true"/>
		<layeroffset x="0.0" y="0.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-100.000000" right="100.000000" top="75.000000" bottom="-75.000000"/>
	<script>
---script for a halloween lvl by tumo---

---defining some stuff---

ring1 = {}
ring2 = {}

Mion = {}
Mion1 = {}
Mion2 = {}

Nyu = {}
Nyu1 = {}
Nyu2 = {}

timer = {}
timer2 = {}
timer3 = {}

kill = {}

berry1 = {}
berry2 = {}

function OnLoad()
	Mx,My = Game.GetEntityPos("Mion")
	Nx,Ny = Game.GetEntityPos("Nyu")
	b1x,b1y = Game.GetEntityPos("berry1")
	b2x,b2y = Game.GetEntityPos("berry2")
	wow = math.random(1,2)	
return true
end

---Death fall---

function kill.OnEnter()
	
	Game.SetPlayerPosition(0, -10000000, 0)
	Game.StartTimer("timer",10,1)
	Game.Message("You're dead")
	
	if wow == 1 then
		Game.CameraMove(Mx,My+10000000)

	else
		Game.CameraMove(Nx,Ny+10000000)

	end
end


function timer.Tick()
	Game.KillPlayer()
end
function timer2.Tick()
	Game.CameraMove(b1x-Mx,b1y-My)
end
function timer3.Tick()
	Game.CameraMove(b2x-Nx,b2y-Ny)
end

function berry1.Touch()
	Game.CameraMove(Mx-b1x,My-b1y)
	Game.StartTimer("timer2",15,1)
end
function berry2.Touch()
	Game.CameraMove(Nx-b2x,Ny-b2y)
	Game.StartTimer("timer3",15,1)
end
	</script>
