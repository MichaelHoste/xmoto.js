zone0 = {}
lighten = {}
check = 0
x, y = 0, 0


function zone0.OnEnter()

	if check==0 then

		Game.Message("Welcome to the hidden mountain level...")
		x,y = Game.GetEntityPos("lighten")
		Game.SetPlayerPosition(x,y,0)

	check=1

end
end

