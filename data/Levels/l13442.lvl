	</layeroffsets>
	<limits left="-18.602362" right="18.602362" top="26.309055" bottom="-26.309055"/>
	<script>
zone = {}
tomato = {}
lighten = {}
x,y = 0,0
check = 0

function zone.OnEnter()
		x,y = Game.GetEntityPos("lighten")
		Game.SetPlayerPosition(x,y,0)
end


function tomato.Touch()
	if check == 0 then
		Game.Message("Yo kids! Remember to eat your vitamins. It makes you cool, just like us!")
		check = 1
end
end
	</script>
