	<info>
		<name>Stewan's first level</name>
		<description>Thanks to manul23 for testing and SeRe for scripting!</description>
		<author>Stewan</author>
		<date>2014-02-09</date>
		<sky>Yellow</sky>
		<border texture="SolidOrange"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Flower" new_name="YellowFlare"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
