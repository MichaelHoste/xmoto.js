	<info>
		<name>Zodiac - Aries</name>
		<description></description>
		<author>fetus</author>
		<date>2014-05-12</date>
		<sky>Black</sky>
		<border texture="invisible"/>
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="TheX"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="0.88" y="0.94" frontlayer="false"/>
		<layeroffset x="0.92" y="0.96" frontlayer="false"/>
		<layeroffset x="0.96" y="0.98" frontlayer="false"/>
