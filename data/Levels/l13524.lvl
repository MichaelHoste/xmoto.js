		<layeroffset x="1.32" y="1.21" frontlayer="true"/>
	</layeroffsets>
	<limits left="-15.000000" right="15.000000" top="11.500000" bottom="-11.500000"/>
	<script>
i = 0
flower = {}
secret = {}
function OnLoad()
Game.Message("Get 4 X's to finish the level!")
return true
end
function flower.Touch()
if Game.RemainingStrawberries() &lt; 2 then
Game.WinPlayer()
end
end
function secret.Touch()
i = 1
end
function Tick()
if i == 1 then
time=Game.GetTime()
Game.SetGravity(0, time)
end
return true
end
	</script>
