<?xml version="1.0" encoding="utf-8"?>
<level id="leg_spinner_77_maximum_reach_training2" rversion="0.5.2">
	<info>
		<name>Leg-Spinner 77 - Maximum Reach - Training 2</name>
		<description>The second level of the Maximum Reach series.</description>
		<author>Leg-Spinner 77 (MotR)</author>
		<date>2013-10-25</date>
		<sky driftColor_b="149" BlendTexture="glass1" driftColor_g="0" driftZoom="0.8" color_g="0" driftColor_a="255" color_a="255" color_b="156" driftColor_r="153" offset="0.019999999553" drifted="true" color_r="191" zoom="1.6"></sky>
		<border texture="invisible"/>
		<music name="blockolando" />
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-12.100000" right="12.100000" top="3.750000" bottom="-3.750000"/>
	<script>
function OnSomersault(bClockWise)
  if(bClockWise == 1)  
  then
    Game.Message("Nice!")
  else
    Game.Message("Nice!")
  end
end

timer = {}

function OnLoad()
  Game.Message("Welcome back to the second level of the Maximum Reach series.")
  Game.StartTimer("timer",375,15)
 return true
end

function timer.Tick(n)
  if n == 1 then
  Game.ClearMessages()
  Game.Message("To finish this level, you will have to take a different") 
  Game.Message("approach to this trick.")
 end

  if n == 2 then
  Game.ClearMessages()
  Game.Message("Recall that in the first level, a message states that you will")
  Game.Message("often need to do the trick differently.")
 end

if n == 3 then
  Game.ClearMessages()
  Game.Message("This is one of those cases.")
 end

if n == 4 then
  Game.ClearMessages()
  Game.Message("For those who would like to know how to finish the level,")
  Game.Message("read further for more information.")
 end

if n == 5 then
  Game.ClearMessages()
  Game.Message("You need to somehow gain enough momentum")
  Game.Message("for the biker to push his head forward.")
 end

if n == 6 then
  Game.ClearMessages()
  Game.Message("To do so, you will need to drive (not max speed) to the end block.")
  Game.Message("Begin by performing a small wheelie.")
 end

if n == 7 then
  Game.ClearMessages()
  Game.Message("Before you reach the flower, reverse the wheelie,")
  Game.Message("thereby effectively performing a stoppie.")
 end

if n == 8 then
  Game.ClearMessages()
  Game.Message("Keep your head under the wreckers, and with your back wheel")
  Game.Message("hit the block after the berry.")
 end

if n == 9 then
  Game.ClearMessages()
  Game.Message("When the rear wheel makes contact with the block,")
  Game.Message("press brake and left.")
 end

if n == 10 then
  Game.ClearMessages()
  Game.Message("This will create the momentum needed.")
 end

if n == 11 then
  Game.ClearMessages()
  Game.Message("If you have done it right, you should have produced")
  Game.Message("the trick.")
 end

if n == 12 then
  Game.ClearMessages()
  Game.Message("Of course, there are faster and more complicated ways to finish")
  Game.Message("this trick but I'll let you find them out yourself.")
 end

if n == 13 then
  Game.ClearMessages()
  Game.Message("In this way, you will be learning what causes the biker to do")
  Game.Message("the trick, and eventually know it well.")
 end

if n == 14 then
  Game.ClearMessages()
  Game.Message("I hope you enjoyed the tutorial, and that was helpful.")
  Game.Message("If you enjoy this series, give some encouraging feedback,")
  Game.Message("I may yet do more. ;)")
 end

if n == 15 then
  Game.ClearMessages()
  Game.Message("Thanks for playing!")
  Game.Message("-MotR")
 end
 end
	</script>
