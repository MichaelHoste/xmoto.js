	<limits left="-137.500000" right="137.500000" top="26.309055" bottom="-26.309055"/>
	<script>
cow1 =  {}
cow2 =  {}
cow3 =  {}
eye1 = {}

i = 0

function OnLoad()
	x,y = Game.GetEntityPos("eye1")
return true
end

function cow1.Touch()
	Game.Message("Nice!")
	Game.SetPlayerPosition(x,y,0)
	i = 1
	
end

function cow2.Touch()
	Game.SetGravity(-9.81, -9.81)
end


function cow3.Touch()
	Game.SetPlayerPosition(x,y,0)
end
function Tick()
	if i &gt; 0 then
		if i == 300 then
			i = 0
		end
		i = i+1
		Game.SetGravity(0,-i)
	end
return true
end
	
	</script>
