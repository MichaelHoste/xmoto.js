<?xml version="1.0" encoding="utf-8"?>
<level id="Retroponglevel" rversion="0.2.5">
	<info>
		<name>Retro Pong</name>
		<description>Scripted Pong level like 1972...</description>
		<author>Unknow~</author>
		<date>2014-04-13</date>
		<sky>Black</sky>
		<border texture="invisible"/>
		<music name="blockolando" />
	</info>
	<limits left="-12.500000" right="12.500000" top="12.500000" bottom="-12.500000"/>
	<script>
player = {}
bot = {}
down = {}
ball = {}
gameloop = {}
connected = true
speed = 2
val = 0.5
richtung = 1
ran = 0
unten = 0
botmove = {}
check = 1
botset = 0
score = 0
score2 = 0
botspeed = 19
sleepvar = 100
sleeptimer = {}
number0_1 = {}
number0_2 = {}
number1_1 = {}
number1_2 = {}
number2_1 = {}
number2_2 = {}
number3_1 = {}
number3_2 = {}
killed = false
win = false
diff = false
var22 = 50
hardtoggle = false
easytoggle = false
moveup = {}
movedown = {}
toggleup = 0
toggledown = 0
range = 12
gameStarted = false
hasMov = false
co = 5

function OnLoad()
Game.CameraMove(8,15)
Game.CameraZoom(-0.11)
Game.SetKeyHook("W","toggleup")
Game.SetKeyHook("S","toggledown")
Game.SetKeyHook("G","start")
Game.SetKeyHook("I","msg")
Game.SetKeyHook("1","easy")
Game.SetKeyHook("2","hard")
Game.SetKeyHook("3","superki")
Game.Message("I for help")
ballposx,ballposy = Game.GetBlockPos("ball")
botposx,botposy = Game.GetBlockPos("bot")
playerposx,playerposy = Game.GetBlockPos("player")
n1x,n1y = Game.GetBlockPos("number0_1")
n2x,n2y = Game.GetBlockPos("number0_2")
Game.Message("Difficulty: Normal")
return true
end


function toggleup()
if hasMov == false or gameStarted == false then
hasMov = true
Game.StartTimer("moveup",1,3.5)
end
end

function toggledown()
if hasMov == false or gameStarted == false then
hasMov = true
Game.StartTimer("movedown",1,3.5)
end
end

function moveup.Tick()
UP()
end

function movedown.Tick()
DOWN()
end

function start()
gameStarted = true
connected = false
Game.StartTimer("gameloop",speed,0)
Game.StartTimer("botmove",botspeed,0)
end

function superki()
var22 = var22 -1
if var22 == 0 then
Game.Message("Superbot activated")
botspeed = 1
end
end

function hard()
if gameStarted == false then
if diff == false then
Game.Message("Difficulty: Hard")
diff = true
val = 0.85
botspeed = 15
hardtoggle = true
range = 11.5
end
end
end

function easy()
if gameStarted == false then
if diff == false then
Game.Message("Difficulty: Easy")
diff = true
val = 0.3
easytoggle = true
botspeed = 55
range = 4
end
end
end

function msg()
Game.Message("W/S: Up/Down")
Game.Message("G: Start")
Game.Message("Press '1' for the Easy mode and '2' for the Hard mode.")
Game.Message("Reach 3 points to win!")
Game.Message("Good luck, you will need it.")
end


function gameloop.Tick()

co = co-1
if co == 0 then
hasMov = false
co =5
end

bx, by = Game.GetBlockPos("ball")
bx2, by2 = Game.GetBlockPos("bot")
bx3, by3 = Game.GetBlockPos("player")

if richtung == 1 then
if ran == 0 then
Game.MoveBlock("ball",val,0)
end
if ran == -1 then
Game.MoveBlock("ball",val,-0.1)
end
if ran == 1 then
Game.MoveBlock("ball",val,0.1)
end
if ran == -2 then
Game.MoveBlock("ball",val,-0.2)
end
if ran == 2 then
Game.MoveBlock("ball",val,0.2)
end

if by &gt;2 then
ran = -1
end

if by &gt;= 15 then
ran = -1
end

if by &lt;-13 then
ran = 1
end
end

if richtung == 0 then
if ran == 0 then
Game.MoveBlock("ball",-val,0)
end
if ran == -1 then
Game.MoveBlock("ball",-val,-0.1)
end
if ran == 1 then
Game.MoveBlock("ball",-val,0.1)
end
if ran == -2 then
Game.MoveBlock("ball",-val,-0.2)
end
if ran == 2 then
Game.MoveBlock("ball",-val,0.2)
end

if by &gt;2 then
ran = -1
end

if by &lt;-13 then
ran = 1
end


if bx &lt; bx3-1 then

if score == 2 and score2 == 2 then
Game.Message("Matchpoint! Try your best!")
end

Game.Message("G: Start")

Game.StopTimer("botmove")
Game.StopTimer("gameloop")
gameStarted = false
connected = true
Game.SetBlockPos("bot",botposx,botposy)
Game.SetBlockPos("ball",ballposx,ballposy)
Game.SetBlockPos("player",playerposx,playerposy)

score2 = score2+1
val = 0.5

if hardtoggle == true then
val = 0.85
end

if easytoggle == true then
val = 0.3
end

if score2 == 1 then
Game.SetBlockPos("number1_2",n2x,n2y-17.5)
Game.SetBlockPos("number0_2",100,100)
end

if score2 == 2 then
Game.SetBlockPos("number2_2",n2x,n2y-17.5)
Game.SetBlockPos("number1_2",100,100)
end


if score2 == 3 then
Game.SetBlockPos("number3_2",n2x,n2y-17.5)
Game.SetBlockPos("number2_2",100,100)
Game.KillPlayer()
Game.StopTimer("gameloop")
Game.StopTimer("botmove")
killed = true
end

connected = true

end



if bx &gt; bx2+1 then
if score == 2 and score2 == 2 then
Game.Message("Matchpoint! Try your best!")
end
Game.Message("G: Start")

Game.StopTimer("botmove")
gameStarted = false
connected = true
Game.StopTimer("gameloop")
Game.SetBlockPos("bot",botposx,botposy)
Game.SetBlockPos("ball",ballposx,ballposy)
Game.SetBlockPos("player",playerposx,playerposy)

score = score+1
val = 0.5
if hardtoggle == true then
val = 1.0
end

if easytoggle == true then
val = 0.30
end


if score == 1 then
Game.SetBlockPos("number1_1",n1x,n1y-17.5)
Game.SetBlockPos("number0_1",100,100)
end

if score == 2 then
Game.SetBlockPos("number2_1",n1x,n1y-17.5)
Game.SetBlockPos("number1_1",100,100)
end

if score == 3 then
Game.SetBlockPos("number3_1",n1x,n1y-17.5)
Game.SetBlockPos("number2_1",100,100)
Game.WinPlayer()
Game.StopTimer("gameloop")
Game.StopTimer("botmove")
win = true
end


connected = true


end





if bx &lt; bx3+1 and by &gt;by3-1 and by &lt; by3+1 then
ran = math.random(-2,2)
val = val +0.015
richtung = 1
end
end






if bx &gt; bx2-1 and by &gt;by2-1 and by &lt; by2+1 then
ran = math.random(-2,2)
botset = math.random(-0.5,0.5)
richtung = 0
end

if check == 1  then
Game.StartTimer("botmove",botspeed,0)
check = 0
end

end

function botmove.Tick()
bx, by = Game.GetBlockPos("ball")
if bx &gt; range then
Game.SetBlockPos("bot",22.8,by+botset)
if by &gt;= 1 then
Game.MoveBlock("bot",0,-0.5)
end
if by &lt;= -12 then
Game.MoveBlock("bot",0,0.5)
end
end
end












function UP()
 bx, by = Game.GetBlockPos("player")
Game.MoveBlock("player",0,0.5)
if connected == true then
Game.MoveBlock("ball",0,0.5)
end
if by &gt;= 1 then
Game.MoveBlock("player",0,-0.5)
if connected == true then
Game.MoveBlock("ball",0,-0.5)
end
end
end

function DOWN()
 bx, by = Game.GetBlockPos("player")
if by &lt;= -12 then
Game.MoveBlock("player",0,0.5)
if connected == true then
Game.MoveBlock("ball",0,0.5)
end
end
Game.MoveBlock("player",0,-0.5)
if connected == true then
Game.MoveBlock("ball",0,-0.5)
end
end
	</script>
