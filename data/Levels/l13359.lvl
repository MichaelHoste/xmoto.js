<level id="sefeinvalidwr" rversion="0.5.2">
	<info>
		<name>SeFe - Invalid WR</name>
		<description>You think you can beat the WR by going right ? No chance.   Gameplay by manul23 - Gfx by SeRe </description>
		<author>SeFe</author>
		<date>2013-12-10</date>
		<sky color_g="78" color_b="219" zoom="0.3" color_a="255" offset="0.0" color_r="15">Blue1InRainbows</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-26.306775" right="26.306775" top="18.600750" bottom="-18.600750"/>
	<script>
zone0 = {}
zone1 = {}
zone2 = {}
zone3 = {}
zone4 = {}
zone5 = {}
zone6 = {}
zone7 = {}
zone8 = {}
check0 = 0
check1 = 0
check2 = 0
check3 = 0
check4 = 0
check5 = 0
check6 = 0
check7 = 0



function zone0.OnEnter()
  Game.SetPlayerPosition(250, 10, 10)
return true
end

function zone0.OnLeave()
check0 = 1
end

function OnWheel2Touchs(challenge)
if check0 == 1 then
Game.KillPlayer()
end
end



function zone1.OnEnter()
if check1 == 0 then
Game.Message("Welcome to our front wheel driving lesson!")
Game.Message("Try how high you can get!")
Game.Message("Good luck!")
end
end

function zone1.OnLeave()
check1 = 1
end

function zone2.OnEnter()
if check2 == 0 then

Game.Message("Let's start with 2 degrees...")
end
end


function zone2.OnLeave()
check2 = 1
end

function zone3.OnEnter()
if check3 == 0 then
  Game.KillEntity("player")
Game.Message("Well done, how about 4 degrees?")
end
end


function zone3.OnLeave()
check3 = 1
end

function zone4.OnEnter()
if check4 == 0 then
Game.Message("Ok, let's try 6 degrees...")
end
end


function zone4.OnLeave()
check4 = 1
end

function zone5.OnEnter()
if check5 == 0 then
Game.Message("Great, but how about 8 degrees?")
end
end


function zone5.OnLeave()
check5 = 1
end

function zone6.OnEnter()
if check6 == 0 then
Game.Message("Wow, you managed all four steps!")
Game.Message("Congratulations and MERRY CHRISTMAS!")
end
end


function zone6.OnLeave()
check6 = 1
end


function zone7.OnEnter()
if check7 == 0 then
Game.Message("Oh my god, you're pro!")
Game.Message("You just managed 10 degrees!")
Game.Message("You deserve to win this way...")
Game.AddPenaltyTime(120) -- je nach bedarf sekunden aendern!
end
end


function zone7.OnLeave()
check7 = 1
end

function zone8.OnEnter()
  Game.WinPlayer()
end
	</script>
