<?xml version="1.0" encoding="utf-8"?>
<level id="serecactus" rversion="0.5.2">
	<info>
		<name>SeRe - Cactus</name>
		<description>Ride the cactus...</description>
		<author>SeRe</author>
		<date>2025-06-04</date>
		<sky driftColor_b="0" BlendTexture="Sky3" driftColor_g="198" driftZoom="9.3" color_g="182" driftColor_a="255" color_b="0" driftColor_r="255" color_a="255" offset="0.017" drifted="true" color_r="255">Sky3</sky>
		<border texture="invisible"/>
		<music name="SpeedItUp" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="YellowFlare"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
