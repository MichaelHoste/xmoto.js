	<limits left="-26.306775" right="26.306775" top="18.600750" bottom="-18.600750"/>
	<script>
------------------------------------Script made by SeRe (Save Urin)----------------------------------
----------------------------------------------16.03.2014---------------------------------------------

--------------oooooooooo--------------
--------------o-----------------------
--------------o-----------------------
--------------o-----------------------
--------------o-----------------------
--------------oooooooooo--------------
--------------o--------o--------------
--------------o--------o--------------
--------------o--------o--------------
--------------o--------o--------------
--------------oooooooooo--------------
--------------oo----------------------
--------------o-o---------------------
--------------o--o--------------------
--------------o---o-------------------
--------------o----o------------------
--------------o-----o-----------------




g = -9.81  
speed = 10

szone = {}
lighten = {}

x,y = 0,0

function szone.OnEnter()
	x,y = Game.GetEntityPos("lighten")
	Game.SetPlayerPosition(x,y,0)
	Game.SetKeyHook("J","Pump") -- bind the J key to the Jump function below
	Game.SetKeyHook("D", "forward")
	Game.SetKeyHook("A", "backward")
	Game.SetKeyHook("W", "up")
	Game.SetKeyHook("S", "down")
	Game.SetKeyHook("R", "stop")
	Game.Message("use W-S-A-D to control your rocket booster and start driving around")
	Game.Message("Press R to turn of the gravity,and J to Jump !")
end


function Pump()
    Game.AddForceToPlayer(0,10000,0,10,0)
end


function forward()
	Game.SetGravity(speed, g)
end

function backward()
	Game.SetGravity(-speed, g)
end

function up()
	Game.SetGravity(0, speed)
end

function down()
	Game.SetGravity(0, -speed)
end

function stop()
	Game.SetGravity(0,0)
end
	</script>
