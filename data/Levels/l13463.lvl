	</layeroffsets>
	<limits left="-26.309055" right="26.309055" top="18.602362" bottom="-18.602362"/>
	<script>

---Seriously, cheating the secrets from here is no cool.---


fucks = 0
star = {}

function OnLoad()
	Game.SetKeyHook("6","smile")
return true 
end


function smile()
	fucks = fucks+1
	if fucks == 3 then
		x,y = Game.GetEntityPos("star")
		Game.SetPlayerPosition(x,y,0)
		Game.CameraMove(0, -37)
		Game.CameraZoom(-0.06)
	end
	if fucks == 6 then
		Game.CameraMove(0, -21)
		Game.CameraZoom(-0.05)
	end
	if fucks == 9 then
		Game.KillPlayer()
		Game.Message("Too greedy.")
	end
end
	</script>
