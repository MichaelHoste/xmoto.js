--------------o-----o-----------------



block0 = {}
block0bl = {}
block1 = {}
block1bl = {}
blocka = {}
blockabl = {}
blockb = {}
blockbbl = {}
block2 = {}
block2bl = {}
block3 = {}
block3bl = {}
block4 = {}
block4bl = {}
block5 = {}
block5bl = {}
block6 = {}
block6bl = {}
block7 = {}
block7bl = {}
block8 = {}
block8bl = {}
block9 = {}
block9bl = {}

zone0 = {}
zone1 = {}
zone2 = {}
zone3 = {}

xa,ya = 0,0
xb,yb = 0,0
x0,y0 = 0,0
x1,y1 = 0,0
x2,y2 = 0,0
x3,y3 = 0,0
x4,y4 = 0,0

timercheck = 0
check0 = 0
check1 = 0
check2 = 0
check3 = 0


timer0 = {}
timer1 = {}
timer2 = {}
timer3 = {}
timer4 = {}


function OnLoad()
Game.Message("Let's see how flexible the bike really is...")
Game.SetDynamicBlockTranslation("block0", -2, 0, 300, 0,300)
Game.SetDynamicBlockTranslation("block0bl", -2, 0, 300, 0,300)
Game.SetDynamicBlockTranslation("block1",2, 0, 300, 0, 300)
Game.SetDynamicBlockTranslation("block1bl",2, 0, 300, 0, 300)
xa,ya = Game.GetBlockPos("blocka")
xb,yb = Game.GetBlockPos("blockb")
x0,y0 = Game.GetBlockPos("block2")
x1,y1 = Game.GetBlockPos("block3")
x2,y2 = Game.GetBlockPos("block5")
x3,y3 = Game.GetBlockPos("block7")
x4,y4 = Game.GetBlockPos("block8")
Game.SetBlockPos("blocka", 1000, 1000)
Game.SetBlockPos("blockb", 1000, 1000)
Game.SetBlockPos("block2", 1000, 1000)
Game.SetBlockPos("block3", 1000, 1000)
Game.SetBlockPos("block5", 1000, 1000)
Game.SetBlockPos("block7", 1000, 1000)
Game.SetBlockPos("block8", 1000, 1000)
Game.StartTimer("timer0", 150, 1)
return 1
end

function zone0.OnEnter()
if check0==0 then
Game.SetBlockPos("block2", x0, y0)
Game.SetBlockPos("block3", x1, y1)
Game.SetDynamicBlockTranslation("block3", -4, 0, 3000, 0,1500)
Game.SetDynamicBlockTranslation("block2", 4, 0, 3000, 0, 1500)
Game.SetDynamicBlockTranslation("block3bl", -4, 0, 3000, 0,1500)
Game.SetDynamicBlockTranslation("block2bl", 4, 0, 3000, 0, 1500)
Game.SetBlockPos("block0", 1000, 1000)
Game.SetBlockPos("block1", 1000, 1000)
Game.SetBlockPos("blocka", 1000, 1000)
Game.SetBlockPos("blockb", 1000, 1000)
check0=1
end
end

function zone1.OnEnter()
if check1==0 then
Game.SetBlockPos("block2", 1000, 1000)
Game.SetBlockPos("block3", 1000, 1000)
Game.SetBlockPos("block5", x2, y2)
Game.SetDynamicBlockTranslation("block4", -2.1, 0, 500, 0, 1000)
Game.SetDynamicBlockTranslation("block6", 2.1, 0, 500, 0, 750)
Game.SetDynamicBlockTranslation("block4bl", -2.1, 0, 500, 0, 1000)
Game.SetDynamicBlockTranslation("block6bl", 2.1, 0, 500, 0, 750)
Game.StartTimer("timer1", 750, 1)
check1=1
end
end

function zone2.OnEnter()
if check2==0 then
Game.SetBlockPos("block4", 1000, 1000)
Game.SetBlockPos("block5", 1000, 1000)
Game.SetDynamicBlockTranslation("block10", -4, 3.8, 600, 0, 300)
Game.SetDynamicBlockTranslation("block10bl", -4, 3.8, 600, 0, 300)
Game.StartTimer("timer4", 200, 1)
check2=1
end
end

function timer0.Tick()
Game.SetBlockPos("block1", 1000, 1000)
Game.SetBlockPos("blocka", xa, ya)
Game.SetBlockPos("blockb", xb, yb)
end

function timer1.Tick()
Game.SetBlockPos("block6", 1000, 1000)
end


function zone3.OnEnter()
if check3==0 then
Game.SetBlockPos("block7", x3, y3)
Game.SetBlockPos("block8", x4, y4)
Game.SetDynamicBlockTranslation("block7", 3, 0, 500, 0, 1000)
Game.SetDynamicBlockTranslation("block8", -3, 0, 500, 0, 1000)
Game.SetDynamicBlockTranslation("block7bl", 3, 0, 500, 0, 1000)
Game.SetDynamicBlockTranslation("block8bl", -3, 0, 500, 0, 1000)
Game.StartTimer("timer2", 750, 1)
Game.StartTimer("timer3", 775, 1)
check3=1
end
end

function timer2.Tick()
Game.SetBlockPos("block7", 1000, 1000)
end


function timer3.Tick()
Game.SetBlockPos("block8", 1000, 1000)
end


function timer4.Tick()
if timercheck==0 then
Game.SetDynamicBlockTranslation("block10", -2, 1.9, 180, 0, 90)
Game.SetDynamicBlockTranslation("block10bl", -2, 1.9, 180, 0, 90)
timercheck=1
end
end
	</script>
