<?xml version="1.0" encoding="utf-8"?>
<level id="sereelasticity" rversion="0.5.2">
	<info>
		<name>SeRe - Elasticity</name>
		<description>Let's see how flexible the bike really is... Thx to Stewan for giving me (GFX) suggestions.</description>
		<author>SeRe</author>
		<date>2014-05-28</date>
		<sky>white</sky>
		<border texture="Black"/>
		<music name="Foxrun" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Strawberry" new_name="crossthingy"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
	</layeroffsets>
	<limits left="-44.750000" right="44.750000" top="12.369500" bottom="-12.369500"/>
	<script>
------------Sorry for that messy script, but in my opinion a WORKING script is a GOOD script :P------------
------------------------------------Script made by SeRe (Save Urin)----------------------------------

--------------oooooooooo--------------
