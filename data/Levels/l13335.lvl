<?xml version="1.0" encoding="utf-8"?>
<level id="sbicy1" rversion="0.5.2">
	<info>
		<name>Icy Conditions - Snow and Ice</name>
		<description>Welcome to the first level of advent calendar</description>
		<author>Daniel</author>
		<date>2013-11-30</date>
		<sky driftColor_b="179" driftColor_a="255" driftColor_g="238" driftZoom="4.0" color_g="255" BlendTexture="sky1" color_a="128" zoom="0.1" driftColor_r="130" color_b="255" offset="0.015" drifted="true" color_r="255">DarkSky</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="0.0" y="0.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-17.500000" right="17.500000" top="30.000000" bottom="-30.000000"/>
	<script>
timery = {}

function OnLoad()
  Game.Message("Welcome to the first level of X-Moto Advent calendar 2013")
  Game.Message("press i for more information")
  Game.SetKeyHook("i", "Infos")
  return true
end


function Infos()
	Game.Message("Following the traditional format of an advent calendar")
	Game.Message("the X-Moto Advent Calendar will ease your anxious wait for Christmas")
	Game.Message("through giving you a new lvl to play for 24 days straight!")
	Game.StartTimer("timery",600,1)
end

function timery.Tick()
	Game.Message("You still have a chance to particiapte, 23 days remaining,")
	Game.Message("So go ahead an upload your lvls for the calendar!")
	Game.Message("Happy waiting and enjoy the lvls!")
end
	</script>
