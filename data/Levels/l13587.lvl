	<script>
secret = {}
endPoint = {}

function OnLoad()

return true
end

function secret.Touch()
  Game.Message("You found princess Zelda!")
  x,y = Game.GetEntityPos("endPoint")
  Game.SetPlayerPosition(x, y, 0)
end
