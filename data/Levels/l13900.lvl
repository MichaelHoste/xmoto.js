<?xml version="1.0" encoding="utf-8"?>
<level id="cirpacbroque" rversion="0.5.2">
	<info>
		<name>Cirpacha's broque</name>
		<description>sexy shapes</description>
		<author>Cirpacha</author>
		<date>2018-01-09</date>
		<sky zoom="1.1" offset="0.0">stone_white</sky>
		<border texture="invisible"/>
	</info>
	<layeroffsets>
		<layeroffset x="0.08" y="0.0" frontlayer="false"/>
		<layeroffset x="0.08" y="0.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-12.500000" right="12.500000" top="9.750000" bottom="-9.750000"/>
	<script>
-- Cirpacha's broque --

-- entities --
zone1 = {}
zone2 = {}
sprite1 = {}
sprite2 = {}
sprite3 = {}
sprite4 = {}
sprite5 = {}
sprite6 = {}
sprite7 = {}
sprite8 = {}

-- timers --
peli1 = {}
peli2 = {}
pelikaynnissa = {}
voitto11 = {}
iikki = {}

-- booleans --
pelissa = false
ekakerta = true

function OnLoad()
	ix, iy = Game.GetEntityPos("sprite1")
	Game.SetBlockCenter("tatti", -12.5, 31.26)
	Game.SetBlockCenter("kantarelli", -12.5, 31.31)
	atx, aty = Game.GetEntityPos("sprite7")
	akx, aky = Game.GetEntityPos("sprite8")
	Game.SetBlockPos("tatti", atx, aty)
	Game.SetBlockPos("kantarelli", akx, aky)
	return true
end

function Tick()
	if Game.IsPlayerInZone("zone2") and pelissa
	then
		Game.StopTimer("peli1")
		Game.StopTimer("peli2")
		Game.StopTimer("pelikaynnissa")
		Game.SetDynamicBlockNone("tatti")
		Game.SetDynamicBlockNone("kantarelli")
		ekakerta = false
	end
	return true
end

function zone1.OnEnter()
	Game.SetDynamicBlockSelfRotation("tatti", 300, 0, 0)
	Game.SetDynamicBlockSelfRotation("kantarelli", -300, 0, 0)
	Game.SetPlayerPosition(ix, iy, 1)
	Game.StartTimer("iikki", 300, 1)
	Game.SetBlockPos("tatti", atx, aty)
	Game.SetBlockPos("kantarelli", akx, aky)
	if ekakerta == true
	then
		Game.Message("yay, it's a random minigame")
	end
	pelialkaa()
	return true
end

function pelialkaa()
	pelissa = true
	Game.StartTimer("peli1", 500, 0)
	Game.StartTimer("peli2", 700, 0)
	Game.StartTimer("pelikaynnissa", 3500, 0)
	return true
end

function iikki.Tick()
	Game.Message("the mushrooms are attacking!")
	return true
end

function peli1.Tick()
	kantmove = math.random(1, 6)
	kantplace = "sprite" .. kantmove
	kx, ky = Game.GetEntityPos(kantplace)
	kaika = Game.GetTime()
	Game.SetDynamicBlockTranslation("kantarelli", kx+2, ky-7, 500, kaika, kaika+500)
	return true
end

function peli2.Tick()
	tatmove = math.random(1, 6)
	tatplace = "sprite" .. tatmove
	tx, ty = Game.GetEntityPos(tatplace)
	taika = Game.GetTime()
	Game.SetDynamicBlockTranslation("tatti", tx+6, ty-7, 700, taika, taika+700)
	return true
end

function pelikaynnissa.Tick()
	Game.SetBlockPos("tatti", 0, 0)
	Game.SetBlockPos("kantarelli", 0,0)
	if ekakerta == true
	then
		if Game.GetTime() &lt; 70.00
		then
			penalty1 = 71.10 - Game.GetTime()
			Game.AddPenaltyTime(penalty1)
		end
		Game.Message("you good and sexy")
		Game.StartTimer("voitto11", 10, 1)
	else
		Game.Message("lol you used checkpoints :////////////")
		Game.StartTimer("voitto11", 10, 1)
	end
	return true
end

function voitto11.Tick()
	Game.WinPlayer()
	return true
end
	</script>
