	<limits left="-105.000000" right="105.000000" top="30.000000" bottom="-30.000000"/>
	<script>
		zone1 = {}
		star1 = {}
		star2 = {}
		i = 0

		function OnLoad()
			
		return true
		end
		
		function zone1.OnEnter()
			Game.Message("Lol, secrets in my levels are a lot harder to find than this.")
		end
		function star2.Touch()
			Game.SetKeyHook("x", "funny")
			Game.Message("You know what marks the place of a treasure?")
		end
		function star1.Touch()
			i = 1
			Game.Message("I think your alarm is on.")
		end
		function Tick()
			if i == 1 then
				time = Game.GetTime()
				if math.sin(time)>0.9 then
					Game.PlaySound("ring")
				end
			end
			if i == 2 then
				time = Game.GetTime()
				Game.SetGravity(0, time)
			end
		return true
		end
		function funny()
			i = 2
			Game.Message("Correct!")
			Game.Mesage("Now, die.")
		end
	</script>
