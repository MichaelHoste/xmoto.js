		<name> Root - Level 2</name>
		<description></description>
		<author>ME</author>
		<date>2014-02-14</date>
		<sky driftColor_b="68" BlendTexture="Sky3" driftColor_g="68" driftZoom="6.4" color_g="68" driftColor_a="255" color_a="255" color_b="68" driftColor_r="68" offset="0.019999999553" drifted="true" color_r="68" zoom="11.7">sky2</sky>
