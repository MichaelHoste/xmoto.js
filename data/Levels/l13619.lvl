	</info>
	<layeroffsets>
		<layeroffset x="0.97" y="0.97" frontlayer="false"/>
		<layeroffset x="0.97" y="0.97" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-117.500000" right="117.500000" top="25.000000" bottom="-25.000000"/>
	<script>
cp = {}
wat = {}
zone1 = {}
zone2 = {}

function wat.Touch()
	x,y = Game.GetEntityPos("cp")
	Game.SetPlayerPosition(x,y,0)
	Game.Message("Useful, isn't it?")
end

i = 0
function zone2.OnEnter()
	if i == 0 then
		Game.Message("woo!")
		i = 1
	end
end

function Tick()
	if i == 1 then
		rand = math.random(-1,1)
		time = Game.GetTime()
		Game.SetGravity(rand*time/1000, rand*time/1000)
	end
return true
end
	</script>
