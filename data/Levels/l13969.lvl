<?xml version="1.0" encoding="utf-8"?>
<level id="cirpachapulsar" rversion="0.5.2">
	<info>
		<name>Cirpacha's pulsar</name>
		<description>inspired by a never-before-seen texture</description>
		<author>Cirpacha</author>
		<date>2021-05-11</date>
		<sky driftColor_b="51" BlendTexture="Space2" driftColor_g="51" zoom="0.4" driftColor_r="51" driftColor_a="255" drifted="true">Space2</sky>
		<border texture="invisible"/>
		<music name="blockolando" />
	</info>
	<theme_replacements>
		<sprite_replacement old_name="Flower" new_name="YellowFlare"/>
		<sprite_replacement old_name="Star" new_name="alien"/>
		<sprite_replacement old_name="Strawberry" new_name="alien"/>
		<sprite_replacement old_name="Wrecker" new_name="MetallicaWrecker"/>
	</theme_replacements>
	<layeroffsets>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="false"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
		<layeroffset x="1.0" y="1.0" frontlayer="true"/>
	</layeroffsets>
	<limits left="-32.500000" right="32.500000" top="32.500000" bottom="-32.500000"/>
	<script>
------- Cirpacha's pulsar -------
--Do not use without permission--
	
	Flare1 = {}
	Flare2 = {}
	Flare3 = {}

	
	--Star1 = {}
	--Star2 = {}
	
	-- concentrator_1
	-- concentrator_2
	-- concentrator_1b
	alien_trigger = {}
	rotator_flare_1 = {}
	rotator_flare_2 = {}
	rotator_flare_3 = {}
	rotator_flare_4 = {}
	
	warning_flare = {}
	warning_flare2 = {}
	
	wrecker_chaser = {}
	wrecker_chaser2 = {}
	finish = {}
	shadow_1 = {}
	
	i = 0
	
	diffInterval = 0
	
	ForceDelay = {}
	concentrator_pulse = {}
	rotateFlares = {}
	ending_timer = {}
	wrecker_chaser_timer = {}
	camera_shake_timer = {}
	
	crash_sound = false
	beingPushed = false
	concentrator_on = false
	about_to_end = false
	
	
---- INITIALIZING ARRAYS ----
	
	-- Array for storing the flares --
	FlaresArray = {}
	itersF = 1
	repeat
		FlaresArray[itersF] = "Flare" .. tostring(itersF)
		itersF = itersF + 1
		local stringTest = "Flare" .. tostring(itersF)
	until _G[stringTest] == nil
	itersF = itersF - 1
	
	-- Array for storing the radii of flares --
	Flares_RadiiArray = {}
	for i=1, itersF do
		Flares_RadiiArray[i] = Game.GetEntityRadius(FlaresArray[i])
	end
	
	DistFromFlare = {}
	
	-- Array for storing the stars --
	StarsArray = {}
	itersS = 1
	repeat
		StarsArray[itersS] = "Star" .. tostring(itersS)
		itersS = itersS + 1
		local stringTest = "Star" .. tostring(itersS)
	until _G[stringTest] == nil
	itersS = itersS - 1
	
	-- Array for storing the radii of stars --
	Stars_RadiiArray = {}
	for i=1, itersS do
		Stars_RadiiArray[i] = Game.GetEntityRadius(StarsArray[i])
	end
	
--------
	
	function OnLoad()
	
		x_prev, y_prev, facing_prev = Game.GetPlayerPosition()
		-- Game.Message("Caution: Flashing images")
	
		Game.CameraZoom(-0.065)
		Game.SetCameraRotationSpeed(0.02)
		
		-- Array for storing the (x,y) ordered pairs of flares --
		-- Cannot be called initially, as position will be (0,0) for every element --
		Flares_CoordinatesArray = {}
		for i=1, itersF do
			x, y = Game.GetEntityPos(FlaresArray[i])
			Flares_CoordinatesArray[i*2-1] = x
			Flares_CoordinatesArray[i*2] = y
		end
		
		-- Align the position of the wrecker chasers relative to the flare --
		Game.SetEntityPos("wrecker_chaser", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2]-10)
		Game.SetEntityPos("wrecker_chaser2", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2]-10)
		
		-- Array for storing the (x,y) ordered pairs of stars --
		Stars_CoordinatesArray = {}
		for i=1, itersS do
			x, y = Game.GetEntityPos(StarsArray[i])
			Stars_CoordinatesArray[i*2-1] = x
			Stars_CoordinatesArray[i*2] = y
		end	
		s = 0
			
		return true
	end

	
	function Tick()
		
---- GRAVITY ----

			local x, y, facing = Game.GetPlayerPosition()
			smallestDist = 100
			
			-- Visual indicator which shows where the center of gravity is relative to the player --
			local gx, gy = Game.GetGravity()
			Game.SetEntityPos("GravityHelper", x+1.8*gx/math.sqrt(gx^2+gy^2), y+1.8*gy/math.sqrt(gx^2+gy^2))

			--if beingPushed == false -- If not being pushed by an external force (doesn't apply in pulsar) --
			--then
				for i = 1, itersF do
					-- Checks the distance from every flare in array --
					DistFromFlare[i] = math.sqrt((x-Flares_CoordinatesArray[2*i-1])^2 + (y-Flares_CoordinatesArray[2*i])^2)-Flares_RadiiArray[i]
					if DistFromFlare[i] &lt; Flares_RadiiArray[i]/3
					then
						DistFromFlare[i] = Flares_RadiiArray[i]/3 -- Limits the acceleration --
					end
					if smallestDist &gt; DistFromFlare[i]
					then
						-- Selects the flare that is closest to the player (unless every flare is too far away) --
						smallestDist = DistFromFlare[i]
						closestFlare = i
					end
				end
		
				if smallestDist ~= 0 -- Not to divide by zero --
				then
					-- Calculates the cos and sin relative to the closest flare --
					cosp = (x-Flares_CoordinatesArray[2*closestFlare-1])/smallestDist
					sinp = (y-Flares_CoordinatesArray[2*closestFlare])/smallestDist
					if concentrator_on == false -- If not inside the end-level machine --
					then
						Game.SetGravity(-cosp*6.5, -sinp*6.5) -- Sets the gravity to point towards the center of the closest flare --
					else
						if about_to_end == false -- If the wreckers are still spinning --
						then
							Game.SetGravity(cosp*4, sinp*4) -- The flare repels the player --
							-- Game.CameraMove(-cosp*5.1, -sinp*5.1) -- Fixes the camera on the flare -- Stopped working at some point? --
						else
							if Game.GetTime() &lt; endtime + 8 -- Before the goal appears --
							then
								Game.SetGravity(0, 0) -- Zero gravity --
								if Game.GetTime() > endtime + 1.5
								then
									Game.CameraMove(0, 0) -- Back to default camera --
									Game.SetDynamicEntitySelfRotation("shadow_1", 20000, endtime+150, 0) -- Rotate the black thing --
								end
							else
								Game.SetGravity(-cosp*100, -sinp*100) -- The flare sucks the player into the goal --
								-- Places the goal and the black thing in the center of the machine --
								if crash_sound == false
								then
									Game.PlaySound("Headcrash")
									crash_sound = true
								end
								Game.SetEntityPos("shadow_1", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2])
								Game.SetEntityPos("finish", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2])
							end
						end
					end
				end

			
---- REPEL FOR ARBITRARY STAR ---- 
-- Work in progress, isn't in use in pulsar --
			--if diffInterval &gt; 3 and beingPushed == false
			--then
			--	local x_curr, y_curr, facing_curr = Game.GetPlayerPosition()

			--	for i=1, itersS do
			--		local xDisp = x_curr - Stars_CoordinatesArray[2*i-1]
			--		local yDisp = y_curr - Stars_CoordinatesArray[2*i]
			--		if math.sqrt(xDisp^2 + yDisp^2) &lt; Stars_RadiiArray[i]
			--		then
			--			local rotateAngle = math.atan2(x_prev - x_curr, y_prev - y_curr) - math.atan2(xDisp, yDisp)
			--			local rotateSin = math.sin(2*rotateAngle)
			--			local rotateCos = math.cos(2*rotateAngle)
						
			--			xForceDir = xDisp*rotateCos - yDisp*rotateSin
			--			yForceDir = xDisp*rotateSin + yDisp*rotateCos
						
			--			local time = Game.GetTime()
			--			Game.AddForceToPlayer(xForceDir*5000, yForceDir*5000, time, time+70, 0)
			--			Game.AddForceToPlayer(-xForceDir*2000, -yForceDir*2000, time+70, time+100, 0)
			--			Game.StartTimer("ForceDelay", 150, 1)
			--			beingPushed = true
			--		end
			--	end
				
			--	x_prev = x_curr
			--	y_prev = y_curr
	
			--	diffInterval = 0
			--end
			--diffInterval = diffInterval + 1			
		return true
	end
	
	-- Part of repel --
	function ForceDelay.Tick()
		beingPushed = false
		Game.Message(Game.GetGravity())
	end
	
	function alien_trigger.Touch()
		-- Moves the machine pieces in place --
		Game.SetBlockPos("concentrator_2", 16.719821929932, 57.731250762939)
		Game.SetBlockPos("concentrator_1", -1000, -1000)
		Game.SetBlockPos("concentrator_1b", -1000, -1000)
		concentrator_on = true -- Acts as a check for a change in gravity --
		
		local ttime = Game.GetTime()
		
		-- Moves the wrecker chaser into place and rotates them around the central flare --
		Game.SetDynamicEntityTranslation("wrecker_chaser", 0, 4.5, 200, ttime, ttime+100)
		Game.SetDynamicEntityRotation("wrecker_chaser", -math.pi/2, 5.5, -427.79, ttime+344.42, ttime+1200)
		Game.SetDynamicEntityTranslation("wrecker_chaser2", 0, 15.5, 688.84, ttime, ttime+344.42)
		Game.SetDynamicEntityRotation("wrecker_chaser2", math.pi/2, 5.5, -427.79, ttime+344.42, ttime+986.105)
		Game.SetDynamicEntityTranslation("wrecker_chaser2", 0, -4.5, 200, ttime+986.105, ttime+1086.105)
		Game.SetDynamicEntityTranslation("wrecker_chaser", 0, -4.5, 200, ttime+1200, ttime+1300)
		
		Game.StartTimer("concentrator_pulse", 150, 8) -- For the little flares around the center --
		Game.StartTimer("ending_timer", 1350, 1) -- Zero gravity time --
		Game.StartTimer("camera_shake_timer", 9, 180) -- Controls the camera shake --
	end
	
	function concentrator_pulse.Tick(n)
		-- Adds additional push to the player with every pulse --
		--local gx, gy = Game.GetGravity()
		--local time = Game.GetTime()
		--Game.AddForceToPlayer(gx*1500, gy*1500, time+20, time+40, 0)
		
		-- Moves the little flares into their homes --
		Game.SetEntityPos("rotator_flare_1", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2]+0.1)
		Game.SetEntityPos("rotator_flare_2", Flares_CoordinatesArray[2*2-1], Flares_CoordinatesArray[2*2]-0.1)
		Game.SetEntityPos("rotator_flare_3", Flares_CoordinatesArray[2*2-1]-0.1, Flares_CoordinatesArray[2*2])
		Game.SetEntityPos("rotator_flare_4", Flares_CoordinatesArray[2*2-1]+0.1, Flares_CoordinatesArray[2*2])
		Game.StartTimer("rotateFlares", 1, 41) -- Actually rotates the little flares --
	end
	
	function rotateFlares.Tick(n)
		local ytime = Game.GetTime()
		Game.SetDynamicEntityRotation("rotator_flare_1", math.pi/2 + ((n-1)*math.pi)/20, 0.1+(n/4.6), 50, ytime, ytime+2)
		Game.SetDynamicEntityRotation("rotator_flare_2", -math.pi/2 + ((n-1)*math.pi)/20, 0.1+(n/4.6), 50, ytime, ytime+2)
		Game.SetDynamicEntityRotation("rotator_flare_3", math.pi + ((n-1)*math.pi)/20, 0.1+(n/4.6), 50, ytime, ytime+2)
		Game.SetDynamicEntityRotation("rotator_flare_4", ((n-1)*math.pi)/20, 0.1+(n/4.6), 50, ytime, ytime+2)
	end
	
	function ending_timer.Tick()
		-- Jolts the player away from the wall --
		local gx, gy = Game.GetGravity()
		Game.AddForceToPlayer(gx*6000, gy*6000, 10, 25, 0)
		
		about_to_end = true -- Zero gravity check --
		endtime = Game.GetTime()
		
		-- Moves the chasers out of the way --
		Game.SetEntityPos("wrecker_chaser", -1000, -1000)
		Game.SetEntityPos("wrecker_chaser2", -1000, -1000)
		
		-- Rotates the little flares --
		Game.SetDynamicEntityRotation("rotator_flare_1", math.pi/2 + ((44-1)*math.pi)/5, 0.1+(44/6.4), 200, endtime, endtime+800)
		Game.SetDynamicEntityRotation("rotator_flare_2", -math.pi/2 + ((44-1)*math.pi)/5, 0.1+(44/6.4), 200, endtime, endtime+800)
		Game.SetDynamicEntityRotation("rotator_flare_3", math.pi + ((44-1)*math.pi)/5, 0.1+(44/6.4), 200, endtime, endtime+800)
		Game.SetDynamicEntityRotation("rotator_flare_4", ((44-1)*math.pi)/5, 0.1+(44/6.4), 200, endtime, endtime+800)
		
		-- Moves the bigger flares towards the center --
		Game.SetEntityPos("warning_flare", Flares_CoordinatesArray[2*2-1]-20, Flares_CoordinatesArray[2*2])
		Game.SetEntityPos("warning_flare2", Flares_CoordinatesArray[2*2-1]+20, Flares_CoordinatesArray[2*2])
		Game.SetDynamicEntityTranslation("warning_flare", 20, 0, 1700, endtime, endtime+850)
		Game.SetDynamicEntityTranslation("warning_flare2", -20, 0, 1700, endtime, endtime+850)
	end
	
	function camera_shake_timer.Tick(n)
		-- Shakes the camera, f(n) = -n^3/864000 + n^2/4800, conditions: f(0)=0, f'(0)=0, f(120)=1 (local maximum), f'(120)=0
		Game.CameraRotate((((-1)^n)*(math.pi)*((-1/864000)*n^3+(1/4800)*n^2))/40)
		if (-1)^n == 1
		then
			Game.PlaySound("Button2", ((-1/864000)*n^3+(1/4800)*n^2)*2)
		end
	end
	
	function wrecker_chaser.Touch()
		Game.KillPlayer()
	end
	
	function wrecker_chaser2.Touch()
		Game.KillPlayer()
	end
	</script>
